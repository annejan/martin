# martin — "OP DE CAMPING" MAX EDITION
# The same 140 BPM / 228s track, but MAXED: denser sequence, aggro camera, sync automation,
# captions, diverse effects. ALL existing assets — no new captures needed.
#
#   MARTIN_SHOW=productions/camping/camping-max.show cargo +nightly run --release
#   MARTIN_SHOW=productions/camping/camping-max.show ./record.sh op-de-camping-max.mp4

# --- settings ---
kind = demo
budget       = 160000
ply = assets/aegg-baked.ply
score = productions/camping/score.txt
bg_dim = 0.35
flash = 0.45
beat = 0.3
pw_splat = 0.004

# --- sequence: 27 parts, continuous, no timing gaps ---
[reel]
# ==== 1 · INTRO (0–14s) · deFEEST drifts in, dissolves to blobs → EXPLODE ====
glb:defeest.glb               @@intro    @11,3                  exit:explode  backdrop:off    # deFEEST mesh → splats → BOOM
# ==== 2 · BUILD (14–43s) · camp assembles: host logo, props, title types in ====
svg:bornhack-2026-square-dark.svg @@build  @5,2     ~morph    ^twist  exit:explode  backdrop:stars   # host camp logo twists in
splat:aegg.ply                           @5,2,1.2 ~morph    ^wind                backdrop:stars   # the ægg hatches
mesh:bitterbal.glb flock:5               @5,2     ~morph    ^turbulence          backdrop:grid    # bitterballen tumble in
text:OP DE CAMPING                        @7,2     ~typewriter ^wave             backdrop:grid    # title types in, rising energy
# ==== 3 · DROP (43–99s) · party ERUPTS: 5 parts, layered, no gaps ====
splat:doggo.ply               @@drop     @10,1.4,1.5 ~morph    ^wave         backdrop:plasma  # crowd cheers (STAND-IN)
splat:supershape.ply                      @10,1.4,1.5 ~morph    ^wave         backdrop:kaleido # rainbow party morph
text:MET deFEEST                           @8,1.4     ~explode  ^wave         backdrop:plasma  # the hook BLASTS
mesh:bitterbal.glb flock:7               @8,1.6     ~morph    ^wind   exit:evaporate backdrop:kaleido # bitterballen rain
splat:galaxy.ply                           @12,1.4    ~morph    ^turbulence   backdrop:plasma  # euphoria nebula
# ==== 4 · BREAKDOWN (99–129s) · the tragic turn: quiet shapes, sad text ====
text:ZONDER deFEEST          @@breakdown  @10,3      ~morph    ^ripple       backdrop:stars   # the tragic statement
splat:helix.ply                             @6,2       ~morph    ^wind         backdrop:warp    # helix drifts through warp
text:IS HET KUT                             @8,2       ~fade     ^wave         backdrop:stars   # punchline sinks in
# ==== 5 · CLIMAX (129–185s) · MAXIMUM ENERGY: 6 parts, tight choreography ====
splat:martin-peace.ply        @@climax    @12,1.4,1.6 ~morph   ^wave         backdrop:plasma  # STAND-IN crowd (peace = party)
text:MET deFEEST                             @8,1.5     ~explode ^wave         backdrop:kaleido # euphoric title blast
splat:galaxy.ply                             @10,1.4    ~morph   ^turbulence   backdrop:plasma  # spins into frenzy
splat:torus.ply                              @8,2       ~morph   ^turbulence   backdrop:kaleido # torus wobbles in rainbow
mesh:bitterbal.glb flock:9                  @8,1.6     ~morph   ^wind         backdrop:plasma  # bitterballen finale
svg:claude.svg                              @5,2       ~morph   ^wave         backdrop:stars   # AI co-pilot
# ==== 6 · OUTRO (185–228s) · credits, thanks, fade ====
wall:GREETINGS|TO ALL|SCENE & CAMP @@outro @6,2.5   ~morph    ^wave         backdrop:stars   # greetings wall
svg:bornhack-2026-wide-dark.svg            @5,2     ~morph    ^wave         backdrop:stars   # host camp logo
wall:ANUS|KLOOT|CINDER                      @6,2.5   ~morph    ^wave         backdrop:stars   # the crew
text:deFEEST                                @7,3     ~pen-write ^wave        backdrop:stars   # signature
text:a deFEEST production                   @5,2.5   ~fade     ^wave exit:evaporate backdrop:off # fades to black

# --- camera: 26 waypoints, wide yaw range, aggressive arcs, deep pitch swoops ---
[camera]
t=0.0     pos=0,0,0  dist=3.8  yaw=1.35  pitch=0.08   # intro: start wide, floating in
t=6.0     pos=0,0,0  dist=3.2  yaw=1.42  pitch=0.10   # slow drift toward the mesh
t=13.7    pos=0,0,0  dist=2.5  yaw=1.55  pitch=0.15   # settle as build starts
t=14.0    pos=0,0,0  dist=2.5  yaw=1.55  pitch=0.15   # build: orbit drift
t=20.0    pos=0,0,0  dist=2.3  yaw=1.35  pitch=0.18   # push toward the aegg
t=28.0    pos=0,0,0  dist=2.7  yaw=1.60  pitch=0.14   # pull back for bitterbal
t=35.0    pos=0,0,0  dist=2.0  yaw=1.20  pitch=0.20   # arc for title reveal
t=42.9    pos=0,0,0  dist=1.7  yaw=1.50  pitch=0.22   # DROP: slam in hard
t=43.0    pos=0,0,0  dist=1.7  yaw=1.50  pitch=0.22   # drop hold
t=55.0    pos=0.3,0,0  dist=1.9  yaw=1.68  pitch=0.20 # arc right across party
t=66.0    pos=-0.2,0,0 dist=1.5  yaw=1.28  pitch=0.26 # swoop left for title blast
t=76.0    pos=0.4,0,0  dist=2.2  yaw=1.72  pitch=0.18 # pull back for bitterbal rain
t=88.0    pos=-0.3,0,0 dist=1.8  yaw=1.18  pitch=0.24 # counter-arc, ride the hook
t=99.4    pos=0,0,0   dist=3.4  yaw=1.40  pitch=0.08  # BREAKDOWN: fall back + sink
t=100.0   pos=0,0,0   dist=3.4  yaw=1.40  pitch=0.08  # sad drift
t=112.0   pos=0,0,0   dist=3.6  yaw=1.48  pitch=0.06  # drift lower
t=120.0   pos=0,0,0   dist=3.7  yaw=1.35  pitch=0.05  # lowest energy
t=128.6   pos=0,0,0   dist=1.4  yaw=1.55  pitch=0.26  # CLIMAX: SLAM IN TIGHT
t=129.0   pos=0,0,0   dist=1.4  yaw=1.55  pitch=0.26  # climax hold
t=142.0   pos=0.3,0.1,0 dist=1.7 yaw=1.68 pitch=0.24  # arc for title
t=152.0   pos=-0.3,0,0  dist=2.0 yaw=1.32 pitch=0.26  # counter-arc
t=163.0   pos=0.4,0.1,0 dist=1.4 yaw=1.62 pitch=0.30  # push into torus
t=173.0   pos=-0.3,0,0  dist=1.8 yaw=1.20 pitch=0.22  # pull for bitterbal
t=185.1   pos=0,0,0    dist=3.2 yaw=1.42 pitch=0.06   # OUTRO: pull back
t=186.0   pos=0,0,0    dist=3.2 yaw=1.42 pitch=0.06   # greetings level
t=195.0   pos=0,0,0    dist=3.0 yaw=1.48 pitch=0.05   # slight drift
t=202.0   pos=0,0,0    dist=3.2 yaw=1.38 pitch=0.05   # counter-drift
t=210.0   pos=0,0,0    dist=3.4 yaw=1.45 pitch=0.04   # hold center
t=218.0   pos=0,0,0    dist=3.6 yaw=1.45 pitch=0.04   # slow pull-back
t=228.0   pos=0,0,0    dist=4.2 yaw=1.45 pitch=0.03   # fade to black

# --- sync track: flash/bg_dim/beat automation timed to music sections ---
[sync]
t=@@intro      flash=0.0  bg_dim=0.6  beat=0.15
t=@@build      flash=0.3  bg_dim=0.35 beat=0.5   exposure=1.1
t=@@drop       flash=0.7  bg_dim=0.12 beat=1.3   exposure=1.2
t=@@bar:50     flash=0.5  bg_dim=0.20 beat=1.0
t=@@breakdown  flash=0.0  bg_dim=0.7  beat=0.1
t=@@climax     flash=0.9  bg_dim=0.06 beat=1.6   exposure=1.4
t=@@outro      flash=0.3  bg_dim=0.4  beat=0.6
t=@@bar:125    flash=0.0  bg_dim=0.0  beat=0.1

# --- caption track: screen-anchored titles per section ---
[caption]
screentext:OP DE CAMPING         in @@intro  out @@build    at 0.5,0.85  size 28  fade 1.0
screentext:BORN 2 deFEEST         in @@build  out @@drop     at 0.5,0.08  size 32  fade 1.0
screentext:MET deFEEST           in @@drop   out @@breakdown at 0.5,0.08  size 40  fade 0.5
screentext:ZONDER deFEEST        in @@breakdown out @@climax at 0.5,0.45  size 42  fade 1.5
screentext:IS HET KUT            in @@bar:62 out @@climax   at 0.5,0.52  size 32  fade 1.0
screentext:MET deFEEST           in @@climax out @@outro    at 0.5,0.08  size 44  fade 0.5
screentext:SCENE & CAMP          in @@outro out @@bar:130   at 0.5,0.88  size 24  fade 1.0
