# martin — CAMPSITE AT DAWN (variant): a softer, lighter take — a clouded dawn sky instead of stars,
# a calmer open camp. Same assemble-over-the-track animation. Procedural splatgen shapes only.
#   MARTIN_SHOW=productions/camping/campsite-dawn.show cargo +nightly run --release

[settings]
kind           = demo
score          = productions/camping/score.txt
budget         = 100000
bg             = clouds          # drifting dawn haze instead of night stars
particles      = embers          # the dying campfire still smoulders
particle_count = 180
bg_dim         = 0.3             # lighter — it's getting light out

[stage]
splat:terrain.ply   @0,-1.2,0       *2.6   spin 0,3,0    ~fade  in intro      # wide open ground
splat:moon.ply      @-1.7,1.3,-2.2  *0.4   spin 0,3,0    ~fade  in intro      # pale low moon, setting
splat:tent.ply      @0.2,-0.45,0.2  *0.9   sway 0,7,0    ~fade  in build      # the tent, centred
splat:pine.ply      @-1.4,-0.35,-0.3 *0.9  sway 0,6,0    ~fade  in build
splat:flame.ply     @-0.4,-0.6,0.7  *0.4   bob 0.04  ^turbulence:0.25  ~fade  in drop  # low embers fire
splat:pine.ply      @1.6,-0.45,0.4  *0.7   sway 0,6,0    ~fade  in climax

[camera]
t=@@intro      pos=0,0.45,0   dist=3.3   yaw=1.35   pitch=0.32
t=@@drop       pos=0,0.18,0   dist=2.4   yaw=1.40   pitch=0.18
t=@@climax     pos=0,0.28,0   dist=2.9   yaw=1.55   pitch=0.24
t=@@outro      pos=0,0.4,0    dist=3.2   yaw=1.40   pitch=0.30

[sync]
t=@@intro      flash=0.1   bg_dim=0.35  beat=0.4
t=@@drop       flash=0.25  bg_dim=0.25  beat=1.0
t=@@climax     flash=0.2   bg_dim=0.2   beat=0.9
t=@@outro      flash=0.1   bg_dim=0.3   beat=0.5
