# martin — NIGHT CAMPSITE: ONE clean tableau that ASSEMBLES over the camping track. A single moonlit
# field, a distant mountain ridge on the horizon, the moon high in the sky → the tent pitches → the
# campfire IGNITES on the drop (only THEN do the sparks fly) → a few pines fill the grove. One of each
# (1 ground, 1 moon, 1 ridge, 1 tent, 1 fire) + a handful of trees. One slow camera drift, no cuts.
# 100% procedural splatgen shapes.
#
#   MARTIN_SHOW=productions/camping/campsite.show cargo +nightly run --release
#   MARTIN_SHOW=productions/camping/campsite.show ./record.sh campsite.mp4

[settings]
kind           = demo
score          = productions/camping/score.txt   # Op de camping — 140 BPM, intro→…→outro
budget         = 120000
bg             = stars
particles      = embers
particle_count = 220
particle_at    = @@drop          # sparks fade in WITH the campfire, not before it's lit
bg_dim         = 0.55

[stage]
# BACKDROP (from the first frame): one distant ridge low on the horizon, the moon high above it, and
# ONE wide flat field for the camp to sit on. The ridge sits FAR back + low so it reads as horizon,
# never as ground; the moon is higher + nearer the camera than the ridge (no "mountains in front of
# the moon"); the field is big + low so its far edge meets the ridge base, not the sky (no blanket).
splat:mountains.ply @0,-1.2,-12.0  *11,3,9  ~fade  in intro               # distant ridge — stretched WIDE (X) so it spans the whole horizon; base hidden, only serrated tops show
splat:moon.ply      @0.8,3.0,-50.0 *7.0   spin 0,3,0   ~fade  in intro    # the moon — REALLY far, CENTERED behind the camp so it stacks above it at any angle
splat:terrain.ply   @0,-1.5,-7     *13,4.5,11   ~fade  in intro         # field — CENTER pushed back (z-7) so this backdrop cloud SORTS BEHIND all props (Gaussian per-cloud sort, no z-buffer). Don't move to z0.

# THE CAMP assembles on the field — props stand UP out of the ground, and kept WELL CLEAR of the fire
# (no flammable tent/tree right next to the flames). Fire centre, tent + grove spaced out around it.
splat:tent.ply      @-1.6,-1.11,0.5  *0.85  sway 0,7,0   ~fade  in build  # the tent pitches (safe distance, stage left)
splat:flame.ply     @0.2,-0.44,0.7   *0.7   bob 0.05  ^turbulence:0.35  ~fade  in drop  # the campfire ignites (centre, clear ground)
splat:pine.ply      @1.7,-0.31,0.3   *0.9   sway 0,6,0   ~fade  in build  # the grove… (stage right, away from the fire)
splat:pine.ply      @2.7,-0.56,-0.4  *0.7   sway 0,6,0   ~fade  in build
splat:pine.ply      @0.5,-0.44,-0.6  *0.8   sway 0,6,0   ~fade  in climax  # centre-left, clear of the tent
splat:pine.ply      @-0.5,-0.38,-1.4 *0.85  sway 0,6,0   ~fade  in climax  # mid-left
splat:pine.ply      @-2.4,-0.31,-1.2 *0.9   sway 0,6,0   ~fade  in climax  # back-centre (deeper in the field)

# CURATED CUT-SEQUENCE: a handful of vetted shots, all at LOW pitch (~0.15-0.30 = the splat sweet spot
# where props stand clear of the ground cloud), CUT between on the section hits (no panning through the
# top-down angles where the terrain eats the props). Glides only within a clean range.
[camera]
t=@@intro      pos=0,-0.30,0.3    dist=7.0   yaw=1.40   pitch=0.30            # wide establishing, low
t=@@build      pos=0,-0.35,0.4    dist=6.2   yaw=1.50   pitch=0.24            # ease in as the tent pitches
t=@@drop       pos=0.3,-0.50,0.8  dist=3.6   yaw=1.52   pitch=0.16   cut      # CUT → fire hero (ignition)
t=@@breakdown  pos=0,-0.40,0.3    dist=5.0   yaw=1.00   pitch=0.22   cut      # CUT → side-on the grove
t=@@climax     pos=0,-0.45,0.3    dist=6.6   yaw=1.34   pitch=0.20   cut      # CUT → grand low wide (moon+ridge+camp)
t=@@outro      pos=0,-0.40,0.3    dist=7.0   yaw=1.46   pitch=0.26            # settle, glide

[sync]
t=@@intro      flash=0.1   bg_dim=0.6   beat=0.4
t=@@build      flash=0.15  bg_dim=0.5   beat=0.7
t=@@drop       flash=0.4   bg_dim=0.4   beat=1.4      # fire + energy
t=@@climax     flash=0.3   bg_dim=0.4   beat=1.2
t=@@outro      flash=0.15  bg_dim=0.55  beat=0.6  bg=fractal   # the night sky dissolves into fractals
