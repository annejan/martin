# martin — NIGHT CAMPSITE: ONE clean tableau that ASSEMBLES over the camping track. A single moonlit
# field, a distant mountain ridge on the horizon, the moon high in the sky → the tent pitches → the
# campfire IGNITES on the drop (only THEN do the sparks fly) → a few pines fill the grove. One of each
# (1 ground, 1 moon, 1 ridge, 1 tent, 1 fire) + a handful of trees. One slow camera drift, no cuts.
# 100% procedural splatgen shapes.
#
#   MARTIN_SHOW=productions/camping/campsite.show cargo +nightly run --release
#   MARTIN_SHOW=productions/camping/campsite.show ./record.sh campsite.mp4

[settings]
kind           = demo
score          = productions/camping/score.txt   # Op de camping — 140 BPM, intro→…→outro
budget         = 120000
morph_count    = 12000          # ~12k splats/prop = the SOFT density sweet spot (140k was ~10x wasteful)
bg             = aurora         # northern-lights night sky (was the lame grey-squares starfield)
post           = chroma         # RGB-split screen-tear on the kick — drive/energy
cam_pump        = 0.10           # subtle kick lunge (was 0.22 — too strong a beat-bounce)
particles       = embers
particle_count  = 420            # roaring fire for the PonyCamp party (was 260)
particle_at     = @@drop         # sparks fade in WITH the campfire, not before it's lit
particle_origin = 0,-0.3,0.3     # embers rise FROM the fire (@0,-0.44,0.3) instead of the whole scene
particle_spread = 0.35           # tight cluster around the flames (1.0 = wide scene-fill)
bg_dim         = 0.6

[stage]
# BACKDROP (from the first frame): one distant ridge low on the horizon, the moon high above it, and
# ONE wide flat field for the camp to sit on. The ridge sits FAR back + low so it reads as horizon,
# never as ground; the moon is higher + nearer the camera than the ridge (no "mountains in front of
# the moon"); the field is big + low so its far edge meets the ridge base, not the sky (no blanket).
splat:mountains.ply @0,-1.2,-12.0  *11,3,9  ~fade  in intro  count:14000  # distant ridge — stretched WIDE (X) so it spans the whole horizon; base hidden, only serrated tops show
splat:moon.ply      @0.8,3.0,-50.0 *7.0   spin 0,3,0  drift 0.05,0.006,0  ~fade  in intro  count:5000  # the moon — REALLY far, CENTERED behind the camp so it stacks above it at any angle
splat:terrain.ply   @0,-1.5,-7     *13,4.5,11   ~fade  in intro  count:28000  # field — CENTER pushed back (z-7) so this backdrop cloud SORTS BEHIND all props (Gaussian per-cloud sort, no z-buffer). Don't move to z0.

# THE CAMP assembles on the field — props stand UP out of the ground, and kept WELL CLEAR of the fire
# (no flammable tent/tree right next to the flames). Fire centre, tent + grove spaced out around it.
# ROOMIER spread (the field has the space; all props well in front of the terrain centre @z-7 -> Z-safe)
splat:tent.ply      @-2.8,-1.11,0.7  *0.85  sway 0,4,0   ~fade  in build  count:9000  # the tent pitches (stage left, out wide)
splat:flame.ply     @0.0,-0.44,0.3   *0.7   bob 0.08  ^turbulence:0.55  ~fade  in drop  count:3000  # the campfire (centre)
splat:pine.ply      @3.0,-0.31,0.5   *0.9   sway 0,8,0  bob 0.04   ~fade  in build  count:6000  # the grove... (stage right)
splat:pine.ply      @3.8,-0.56,-0.6  *0.7   sway 0,11,0   ~fade  in build  count:6000
splat:pine.ply      @1.7,-0.44,-1.7  *0.8   sway 0,5,0  bob 0.05   ~fade  in climax  count:6000  # centre-right-back
splat:pine.ply      @-1.5,-0.38,-1.9 *0.85  sway 0,9,0   ~fade  in climax  count:6000  # centre-left-back
splat:pine.ply      @-3.5,-0.31,-0.9 *0.9   sway 0,7,0  bob 0.03   ~fade  in climax  count:6000  # far-left

# logos + text (Z-safe: kept in FRONT of the backdrop). deFEEST STAYS the whole show (no `out`).
text:deFEEST        @-1.7,0.7,1.0 *0.42  ~pen-write  tint:brand  in build   # wordmark, OFF-CENTRE upper-left (not dead-centre), stays for the party

# ── STORYBOARD: PonyCamp 2026 ──────────────────────────────────────────────────────────────────
# THE HORSE walks into the party during the slow breakdown: fades in far-left (the open field the
# breakdown camera frames), then travel: EASES it in toward the camp over ~16s and HOLDS there (a real
# walk-in-and-stop — drift used to slide it off-screen-right). Faces its travel direction (rot 0,180,0),
# bounces on the beat (^pulse) once the climax ramps the beat up. Textured chestnut (glTF sampler reads baseColorTexture).
mesh:paard.glb  @-9.0,-0.5,-4.5  *0.9  rot 0,180,0  travel:-2.2,-0.868,-4.5@breakdown,16  sway 0,4,0  bob 0.05  ^pulse:0.4  ~fade  in breakdown   # 🐴 walks in from far-left and rests DEEP BEHIND the camp (z-4.5 — well behind tent/fire/pines, in front of terrain z-7 so still Z-safe), grazing far back. travel: not drift.

# THE CELEBRATION when the music picks up (climax→end): a translucent beer by the fire, bouncing
# bitterbal snacks, the dog joins, and the PonyCamp 2026 banner. (Beat ramps up in [sync] → all bounce.)
mesh:bier.glb       @1.6,-0.55,0.9  *0.45  alpha:0.16  bob 0.04  spin 0,45,0  ~fade  in climax   # 🍺 very translucent glass mug by the fire, turning slowly on its Y axis (~8s/rev)
mesh:bitterbal.glb  @-0.9,-0.32,1.0 *0.20  spin 19,37,13  bob 0.14  ^pulse:0.6  tint:fry  ~fade  in climax   # 🟤 bouncing snack
mesh:bitterbal.glb  @0.8,-0.30,1.2  *0.18  spin 23,29,17  bob 0.16  ^pulse:0.6  tint:fry  ~fade  in climax
mesh:bitterbal.glb  @0.1,-0.10,1.5  *0.16  spin 31,13,41  bob 0.18  ^pulse:0.6  tint:fry  ~fade  in climax
mesh:paard.glb      @1.0,-0.775,-4.0 *0.8   rot 0,200,0  sway 0,5,0  bob 0.05  ^pulse:0.4  tint:fry  ~fade  in climax   # 🐴 a 2nd pony grazing DEEP BEHIND the camp (back-right), joins for the party
splat:doggo.ply     @0.9,-1.181,1.5  *0.5   sway 0,7,0  bob 0.04  ~fade  in climax   # 🐕 the dog joins too (doggo.ply — PD, now git-tracked so it bundles in CI)
text:PonyCamp 2026  @1.4,1.5,1.0   *0.5   ~pen-write  tint:brand  bob 0.06  in climax   # the festival banner, upper-right third

# FLOWING camera: now the terrain sorts behind the props (Z-safe at any angle), the camera can FLOW
# around the camp instead of cutting between safe stills. A slow orbit (yaw drifts ~1.0→2.0) + a crane
# up for the climax, with ONE hard cut punching onto the fire on the drop. Low-ish pitch throughout.
# RULE-OF-THIRDS framing: aim OFF the focal point so it lands on a third (not dead-centre), switch
# sides shot-to-shot for variety, keep the horizon low so the aurora sky breathes. (Verified via
# show_layout.py's screen-position report: subjects toward ±0.33, fire never at 0,0.)
[camera]
# Each scene its OWN viewpoint + a dynamic ZOOM-OUT arc: tight on the drop → pull progressively out →
# the climax is a big wide REVEAL (whole camp + moon + mountains) → the outro settles into a quiet,
# intimate frame (one pony, a pine, the moon, the ridge). Composed in Blender via the bridge.
t=@@intro      pos=1.3,0.25,0.3    dist=9.5   yaw=1.00   pitch=0.16          # high wide establish: camp left third, moon+aurora upper-right
t=@@build      pos=0.6,-0.20,0.4   dist=5.4   yaw=1.45   pitch=0.20          # drop IN + orbit onto the assembling camp
t=@@drop       pos=0.3,-0.60,0.6   dist=3.0   yaw=1.55   pitch=0.08   cut    # CUT: punch low on the fire as it ignites
t=@@breakdown  pos=-1.3,-0.35,0.4  dist=6.8   yaw=2.05   pitch=0.14          # SWITCH sides: low along the open field as the horse walks in
t=@@climax     pos=-1.2,0.30,-3.0  dist=11.0  yaw=1.62   pitch=0.10          # ZOOM-OUT REVEAL: the whole camp + moon + mountains, pulled way back
t=150          pos=-0.4,0.15,-2.0  dist=8.5   yaw=1.95   pitch=0.14          # …then DRIFT in + orbit right across the party (don't hold the reveal — keep moving)
t=170          pos=0.5,0.00,-1.0   dist=7.0   yaw=1.35   pitch=0.18          # counter-arc the other way, dipping into the camp
t=@@outro      pos=-1.8,0.60,-5.2  dist=4.4   yaw=1.42   pitch=-0.02         # settle to the quiet: one pony, a pine, the moon, the ridge

[sync]
t=@@intro      flash=0.08  bg_dim=0.80  beat=0.25                # calm: aurora breathes, barely any beat
t=@@build      flash=0.15  bg_dim=0.6   beat=0.7                 # energy creeps in
t=@@drop       flash=0.7   bg_dim=0.5   beat=1.8                 # DROP: fire erupts, aurora pulses, full kick
t=@@breakdown  flash=0.2   bg_dim=0.62  beat=0.7                 # pull back, hushed
t=@@climax     flash=0.7   bg_dim=0.45  beat=1.9                 # PARTY: beat up → camp + horse + snacks all bounce harder, brighter night
t=@@outro      flash=0.35  bg_dim=0.55  beat=1.3  bg=fractal     # keep the celebration going as the sky dissolves into fractals
