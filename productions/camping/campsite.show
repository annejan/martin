# martin — A NIGHT CAMPSITE: a tent + pines + a campfire (flame + rising embers) on rolling ground,
# under a starry sky with a moon. Built ENTIRELY from procedural splatgen shapes — no captures, no
# baked .ply (the engine synthesizes them on launch). A static tableau on the composition stage.
#
#   MARTIN_SHOW=productions/camping/campsite.show cargo +nightly run --release
#
# Compose line: <source> [@x,y,z] [*scale] [spin a,b,c deg/s] [sway a,b,c deg] [bob amp] [drift …]

[settings]
budget         = 100000          # splats PER object
bg             = stars           # night sky behind it all
particles      = embers          # campfire sparks drifting up
particle_count = 280
bg_dim         = 0.5

[compose]
splat:terrain.ply   @0,-1.25,0      *2.4   spin 0,5,0      # rolling ground (slow drift), the floor
splat:tent.ply      @-1.0,-0.45,0.2 *0.85  sway 0,9,0      # the tent, pitched on the left
splat:pine.ply      @1.15,-0.30,-0.4 *0.95 sway 0,7,0      # a conifer
splat:pine.ply      @1.85,-0.45,0.6 *0.65  sway 0,7,0      # a smaller one behind
splat:flame.ply     @0,-0.55,0.7    *0.5   bob 0.05        # the campfire — embers rise off it
splat:moon.ply      @1.5,1.35,-2.0  *0.55  spin 0,4,0      # the moon, up in the sky

# camera: a gentle high-ish front orbit framing the whole site
[camera]
t=0.0   pos=0,0.25,0   dist=2.9   yaw=1.25   pitch=0.20
t=14.0  pos=0,0.25,0   dist=2.7   yaw=1.62   pitch=0.18
t=28.0  pos=0,0.25,0   dist=2.9   yaw=1.25   pitch=0.20
