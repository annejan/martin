# martin — NIGHT CAMPSITE (animated): the camp ASSEMBLES over the camping track — empty moonlit land →
# the tent goes up → the campfire IGNITES on the drop (and only THEN do the sparks fly) → the pines
# fill in at the climax. Camera surveys wide, eases in near the fire, pulls back to orbit. The terrain
# is a wide static ground (no spin → no clipping); props sit on it. 100% procedural splatgen shapes.
#
#   MARTIN_SHOW=productions/camping/campsite.show cargo +nightly run --release
#   MARTIN_SHOW=productions/camping/campsite.show ./record.sh campsite.mp4

[settings]
kind           = demo
score          = productions/camping/score.txt   # Op de camping — 140 BPM, intro→…→outro
budget         = 100000
bg             = stars
particles      = embers
particle_count = 220
particle_at    = @@drop          # sparks fade in WITH the campfire, not before it's lit
bg_dim         = 0.55

[stage]
splat:terrain.ply   @0,-1.7,0       *5.0   ~fade  in intro              # a WIDE static field (props are a small cluster in it)
splat:moon.ply      @1.6,1.5,-2.6   *0.6   spin 0,3,0   ~fade  in intro # the moon, up in the sky
splat:tent.ply      @-0.7,-0.62,0.3 *0.8   sway 0,7,0   ~fade  in build # pitch the tent, on the field
splat:pine.ply      @0.85,-0.5,0.1  *0.9   sway 0,6,0   ~fade  in build # first conifer
splat:flame.ply     @0,-0.7,0.6     *0.7   bob 0.05  ^turbulence:0.35  ~fade  in drop  # the campfire (bigger, readable)
splat:pine.ply      @1.4,-0.58,0.5  *0.6   sway 0,6,0   ~fade  in climax # the grove fills in
splat:pine.ply      @-1.4,-0.55,-0.1 *0.7  sway 0,6,0   ~fade  in climax # a distant tree

# camera: ZOOMED OUT so the whole camp sits in the field, with more pitch (looking down at the floor).
[camera]
t=@@intro      pos=0,0.35,0   dist=6.0   yaw=1.30   pitch=0.38
t=@@build      pos=0,0.3,0    dist=5.5   yaw=1.46   pitch=0.34
t=@@drop       pos=0,0.2,0    dist=4.8   yaw=1.52   pitch=0.30   # ease toward the fire, still wide
t=@@breakdown  pos=0,0.28,0   dist=5.3   yaw=1.30   pitch=0.32
t=@@climax     pos=0,0.32,0   dist=5.8   yaw=1.15   pitch=0.36   # orbit the full site
t=@@outro      pos=0,0.35,0   dist=6.0   yaw=1.45   pitch=0.38

[sync]
t=@@intro      flash=0.1   bg_dim=0.6   beat=0.4
t=@@build      flash=0.15  bg_dim=0.5   beat=0.7
t=@@drop       flash=0.4   bg_dim=0.4   beat=1.4      # fire + energy
t=@@climax     flash=0.3   bg_dim=0.4   beat=1.2
t=@@outro      flash=0.15  bg_dim=0.55  beat=0.6  bg=fractal   # the night sky dissolves into fractals for the finale
