# martin — CAMP FLOW: a dreamy morph journey through camping scenes, the splats FLOWING from one into
# the next (martin's signature). The moonlit field flows into a tent → the tent erupts into the
# campfire on the drop → the fire drifts into a misty forest → the forest rises into the cosmos →
# and balls up into a deep-fried bitterbal that becomes the deFEEST logo (loops). Each scene its own
# backdrop + mood. 100% procedural splatgen shapes + the two in-repo meshes.
#
#   MARTIN_SHOW=productions/camping/campflow.show cargo +nightly run --release
#   MARTIN_SHOW=productions/camping/campflow.show ./record.sh campflow.mp4

[settings]
kind           = demo
score          = productions/camping/score.txt   # Op de camping — 140 BPM
budget         = 200000          # one morphing cloud → can afford crisp
ply            = assets/terrain.ply   # .ply root = assets/ so the splat: shapes resolve
particles      = embers
particle_count = 240
particle_at    = @@drop          # the sparks ignite with the campfire scene
bg             = stars
bg_dim         = 0.5
flash          = 0.25

# Each shot morphs IN from the previous scene's splats → the flow between scenes IS the show.
[reel]
# each scene = several SEPARATE clouds, morphing as a group into the next scene's clouds (cities-style)
splat:terrain.ply+pine.ply                 @@intro      @6,5     ~fade                  beat:0    backdrop:stars   # the moonlit field + a lone pine
splat:terrain.ply+tent.ply+pine.ply        @@build      @6,4,0   ~morph                 beat:0.6  backdrop:stars   # a tent pitches; the field flows into camp
splat:flame.ply+tent.ply+pine.ply          @@drop       @6,1,0   ~shockwave ease:snap   beat:1.5  flash:0.7  backdrop:stars  # the campfire ERUPTS into the camp
splat:pine.ply+pine.ply+pine.ply           @@breakdown  @8,4,0   ~morph  ^wind:0.2      beat:0.8  backdrop:clouds  # the camp drifts into a misty forest
splat:moon.ply+terrain.ply                 @@climax     @10,4,0  ~ball                  beat:1.4  backdrop:fractal # the forest rises into a moonlit cosmos
mesh:bitterbal.glb                         @@outro      @6,4,0   ~morph  tint:fry       beat:0.8  backdrop:fractal # …and balls into a deep-fried bitterbal
mesh:defeest.glb    rot:180,0,0            @4,4         ~morph                 beat:0    backdrop:stars   # → the deFEEST logo (wrap)

# camera: a slow dreamy drift, easing in on the campfire drop, rising for the cosmos.
[camera]
t=@@intro      pos=0,0.2,0   dist=3.4   yaw=1.30   pitch=0.20
t=@@drop       pos=0,0.1,0   dist=2.6   yaw=1.50   pitch=0.12   # in on the fire
t=@@breakdown  pos=0,0.15,0  dist=3.0   yaw=1.30   pitch=0.16
t=@@climax     pos=0,0.3,0   dist=3.2   yaw=1.55   pitch=0.30   # rise into the sky
t=@@outro      pos=0,0.2,0   dist=3.0   yaw=1.40   pitch=0.18

[sync]
t=@@intro      flash=0.1   bg_dim=0.55  beat=0.4
t=@@drop       flash=0.6   bg_dim=0.4   beat=1.5
t=@@climax     flash=0.4   bg_dim=0.35  beat=1.3
t=@@outro      flash=0.2   bg_dim=0.5   beat=0.7
