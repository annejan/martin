# martin — NIGHT CAMPSITE MAX EDITION
# Same moonlit tableau, MAXED: denser camp, Lissajous bitterballen,
# scrolling credits, aggro camera, sync+exposure.
#   MARTIN_SHOW=productions/camping/campsite-max.show cargo +nightly run --release
#   MARTIN_SHOW=productions/camping/campsite-max.show ./record.sh campsite-max.mp4

[settings]
kind           = demo
score          = productions/camping/score.txt
budget         = 140000
morph_count    = 15000
bg             = aurora
post           = chroma
cam_pump       = 0.12           # subtle kick-lunge (was 0.30 — whiplash); the camera breathes on the beat, not headbangs
sidechain      = 0.5            # the kick DUCKS the whole stage (classic pump) — props breathe with the track
fft            = 1.6           # crank the FFT-reactive backdrops (plasma/fractal pulse harder on the spectrum)
particles      = embers
particle_count = 666
particle_at    = @@drop         # sparks rise WITH the campfire (it lights on the drop)
particle_out   = @@breakdown    # …and LEAVE with it when the camp flies away (no orphan embers on the lone horse)
particle_back  = @@climax       # …and return when the fire re-ignites for the party
particle_origin = 0,-0.3,0.3
particle_spread = 1.8,1.0,1.8
bg_dim         = 0.6
sort_bits      = 16            # PERF: coarse 16-bit depth sort — safe for all-synthetic content (no real
                               # captures here); ~free fps (the sort dominates at low res). Captures want 32.
# PERF: the backdrop (terrain/mountains/moon) is ~68% of the frame — full-screen soft disks overdrawing
# behind everything. Instead of a GLOBAL splat_scale (which thins the props/text too), each backdrop prop
# carries a per-object `dscale:` to shrink JUST its disks, and the mountains are flattened to a thin wall
# (a distant ridge needs no depth). Foreground props/text stay at full disk size (1.0).

[stage]
# ════════════ THE SKY + FIELD — persist the whole show (only the CAMP comes and goes) ════════════
splat:mountains.ply @0,-1.2,-12.0  *9,3,2.2   dscale:0.45  ~fade  in intro  count:8000  # thin ridge WALL (depth 7→2.2) + small disks
splat:moon.ply      @0.8,3.0,-50.0 *7.0      dscale:0.85  spin 0,3,0  drift 0.05,0.006,0  ~fade  in intro  count:5000  # bigger disks (a smooth sphere, not grainy)
splat:terrain.ply   @0,-1.7,-7.5   *19,2.0,9 dscale:0.5   ~fade  in intro  count:18000  # ground: wider extent (rim off-screen) + softer disks
# (galaxy nebula cut — at alpha 0.08 it was invisible but a full-screen disk = pure overdraw)
splat:star.ply      @2.5,2.5,-9    *0.3   alpha:0.4   spin 4,6,3  bob 0.10  ^pulse:0.7  path:orbit:0.2,0.15,0.25   ~fade  in intro  count:2000
splat:star.ply      @-2.0,2.0,-10  *0.25  alpha:0.35  spin 5,3,4  bob 0.08  ^pulse:0.6  path:orbit:0.18,0.12,0.3   ~fade  in intro  count:1500
splat:star.ply      @3.0,1.5,-8    *0.2   alpha:0.3   spin 3,7,2  bob 0.12  ^pulse:0.8  path:orbit:0.15,0.1,0.2    ~fade  in intro  count:1000

# ════════════ ACT 1 — THE CAMP (build→drop) — it FLIES AWAY at the breakdown ════════════
# Every camp prop carries `out breakdown` + a `travel:` to an off-screen point @breakdown, so when
# deFEEST leaves the whole camp lifts/scatters off + fades — the bare moonlit field + the lone horse
# remain. "Zonder deFEEST is het kut." (Compose objects fade on `out`; the travel makes it a fly-away.)

# TENTS — pitch in (~drop) on the build; fly off + fade at the breakdown. Taller per-axis so they read as tents.
splat:tent.ply      @-2.8,-1.11,0.7  *0.85,1.3,0.85  ~drop  sway 0,4,0  travel:-15,4,0.7@breakdown,3.5   in build  out breakdown  count:9000
splat:tent.ply      @4.0,-1.08,1.2   *0.55,0.85,0.55 rot 0,30,0  ~drop  sway 0,3,0  travel:16,4,1.2@breakdown,3.5  in drop  out breakdown  count:5000

# CAMPFIRE — IGNITES with a shockwave-blast on the drop; rises away (smoke) + fades at the breakdown.
splat:flame.ply     @0.0,-0.44,0.3   *0.72  ~shockwave  bob 0.11  ^turbulence:0.72  travel:0,9,0.3@breakdown,3.5  in drop  out breakdown  count:3600

# GROVE (build/drop) — fly up + fade at the breakdown.
splat:pine.ply      @3.0,-0.31,0.5   *1.2   ~fade  sway 0,8,0  bob 0.04   travel:5,7,0.5@breakdown,3.5    in build  out breakdown  count:7000
splat:pine.ply      @3.8,-0.56,-0.6  *0.55  ~fade  sway 0,13,0  bob 0.03  travel:7,7,-0.6@breakdown,3.5   in build  out breakdown  count:4000
splat:pine.ply      @-4.0,-0.48,1.2  *0.9   ~fade  sway 0,6,0  bob 0.04   travel:-7,7,1.2@breakdown,3.5   in drop  out breakdown  count:6000

# CARAVAN — parks in the build (~drop); rolls off-left + fades at the breakdown.
mesh:caravan.glb    @-2.7,-0.55,-0.4 *0.7   rot -0,122.7,-0  disk:0.4  ~drop  travel:-16,1,-0.4@breakdown,3.5  in build  out breakdown  count:9000

# BARNYARD (build/drop) — scatter outward + fade at the breakdown.
mesh:geit.glb  @-2.4,-1.05,2.1  *0.5   rot 0,-4,0   sway 0,5,0  bob 0.05   ~fade  travel:-12,-1,5@breakdown,3.5  in build  out breakdown  count:14000
mesh:geit.glb  @2.6,-1.24,2     *0.45  rot -0,-101.2,-0  sway 0,6,0  bob 0.06  ~fade  travel:12,-1,5@breakdown,3.5  in build  out breakdown  count:12000
mesh:pauw.glb  @-1.8241,-1.3,-0.4451  *0.55  rot 0,55,0   spin 0,16,0  bob 0.05  ^pulse:0.4  ~fade  travel:-13,-1,-3@breakdown,3.5  in drop  out breakdown  count:12000
mesh:cavia.glb @-1.15,-1.12,1.45  *0.26  rot 0,28,0   sway 0,10,0  bob 0.035  ^jitter:0.4  ~fade  travel:-10,-1,6@breakdown,3  in build  out breakdown  count:5000
mesh:cavia.glb @-0.78,-1.10,1.55  *0.22  rot 0,-18,0  sway 0,12,0  bob 0.04   ^jitter:0.4  ~fade  travel:-9,-1,6@breakdown,3   in build  out breakdown  count:4000

# WORDMARK — deFEEST opens the camp (build), LEAVES at the breakdown (the dip), EXPLODES back on the climax.
text:deFEEST        @-1.7,0.7,1.0 *0.42  ~pen-write  tint:brand  in build  out breakdown
text:deFEEST        @-1.4,0.9,1.0 *0.6   ~explode    font:defeest  tint:brand  bob 0.05  in climax  # the joyful comeback BURSTS in

# ════════════ ACT 2 — BREAKDOWN — the lone horse walks the empty field ════════════
mesh:paard.glb  @-9.0,-0.5,-4.5  *0.9  count:12000  rot 0,180,0  travel:-2.2,-0.868,-4.5@breakdown,16  sway 0,4,0  bob 0.05  ^pulse:0.4  ~fade  in breakdown  out climax

# ════════════ ACT 3 — CLIMAX — the camp BURSTS BACK + the party ERUPTS (MET deFEEST) ════════════
# Hero camp re-assembles with explosive entrances; flying bitterballen rain in; all hold to the outro.
splat:tent.ply      @-2.8,-1.11,0.7  *0.85,1.3,0.85 ~shockwave  sway 0,4,0  in climax  count:9000   # the tent SLAMS back up
splat:flame.ply     @0.0,-0.44,0.3   *0.8   ~shockwave  bob 0.11  ^turbulence:0.8  in climax  count:4200  # fire re-ignites, bigger
mesh:caravan.glb    @-2.7,-0.55,-0.4 *0.7   rot -0,122.7,-0  disk:0.4  ~drop  in climax  count:9000
splat:pine.ply      @1.7,-0.44,-1.7  *0.8   ~drop  sway 0,5,0  bob 0.05   in climax  count:6000
splat:pine.ply      @-1.5,-0.38,-1.9 *1.15  ~drop  sway 0,9,0  bob 0.04   in climax  count:7000
splat:pine.ply      @-3.5,-0.31,-0.9 *0.65  ~drop  sway 0,7,0  bob 0.03   in climax  count:4500
mesh:bier.glb       @1.6,-0.55,0.9  *0.45  alpha:0.16  bob 0.04  spin 0,45,0  ~fade  in climax  count:5000
# 5 bitterballen RAIN in (~drop = flying snacks), weave a bounded Lissajous near the fire.
mesh:bitterbal.glb  @-0.9,-0.32,1.0 *0.20  ~drop  path:liss:0.35,0.25,0.3,2,3,1,0.45  bob 0.10  ^pulse:0.6  spin 19,37,13  tint:fry  in climax  count:3000
mesh:bitterbal.glb  @0.8,-0.30,1.2  *0.18  ~drop  path:liss:0.3,0.3,0.25,3,1,2,0.50   bob 0.12  ^pulse:0.6  spin 23,29,17  tint:fry  in climax  count:2500
mesh:bitterbal.glb  @0.1,-0.10,1.5  *0.16  ~drop  path:liss:0.28,0.22,0.32,1,3,2,0.40 bob 0.12  ^pulse:0.6  spin 31,13,41  tint:fry  in climax  count:2500
mesh:bitterbal.glb  @-1.5,-0.25,0.5 *0.22  ~drop  path:liss:0.32,0.28,0.3,2,1,3,0.55  bob 0.10  ^pulse:0.5  spin 11,23,7   tint:fry  in climax  count:3000
mesh:bitterbal.glb  @1.8,-0.28,0.3  *0.15  ~drop  path:liss:0.3,0.26,0.28,3,2,1,0.48  bob 0.12  ^pulse:0.7  spin 17,43,29  tint:fry  in climax  count:2500
mesh:paard.glb      @1.0,-0.775,-4.0 *0.8   count:12000  rot 0,200,0  sway 0,5,0  bob 0.05  ^pulse:0.4  tint:fry  ~fade  in climax
splat:doggo.ply     @1.96,-1.16,1.2  *0.5   rot 0,-16,0  sway 0,7,0  bob 0.04  travel:1.8,-1.1562,1.2@climax,14  ~fade  in climax  count:8000
mesh:pauw.glb  @-1.8241,-1.3,-0.4451  *0.55  rot 0,55,0   spin 0,16,0  bob 0.05  ^pulse:0.4  ~drop  in climax  count:12000  # the BLUE peacock struts back in for the party (it left at the breakdown)
mesh:pauw.glb  @1.0301,-1.33,-1.98  *0.6   rot 0,-55,0  spin 0,12,0  bob 0.06  ^pulse:0.6  tint:white  ~drop  in climax  count:12000  # the rare WHITE peacock parades for the party

# Festival title card — TYPEWRITER-reveal on the build, held to the outro (the brand persists).
text:PonyCamp       @0,1.25,1.0    *0.5   ~typewriter  font:defeest  tint:brand  bob 0.05  in build  out outro
text:Fun en Games   @0,0.78,1.0   *0.3   ~typewriter  font:defeest  tint:brand  bob 0.04  in build  out outro

# ── CREDITS: Bevy UI scrolling captions (see [caption] below) ──

[camera]
t=@@intro      pos=1.0,-0.15,0.5   dist=6.8   yaw=1.05   pitch=0.06
t=@@bar:4      pos=0.8,-0.18,0.4   dist=6.0   yaw=1.20   pitch=0.09
t=@@build      pos=0.6,-0.20,0.4   dist=5.4   yaw=1.45   pitch=0.20
t=@@bar:12     pos=0.4,-0.40,0.5   dist=4.2   yaw=1.50   pitch=0.15
t=@@drop       pos=0.3,-0.60,0.6   dist=2.5   yaw=1.55   pitch=0.08   cut
t=@@bar:30     pos=-0.3,-0.50,0.4  dist=3.2   yaw=1.75   pitch=0.12   cut
t=@@bar:45     pos=0.6,-0.40,0.3   dist=3.8   yaw=1.35   pitch=0.14   cut
t=@@bar:52     pos=-0.4,-0.30,0.2  dist=4.5   yaw=1.80   pitch=0.16
t=@@breakdown  pos=-1.3,-0.35,0.4  dist=6.8   yaw=2.05   pitch=0.14
t=@@bar:65     pos=-1.5,-0.30,0.3  dist=7.5   yaw=2.10   pitch=0.12
t=@@climax     pos=-0.6,0.05,-1.2  dist=5.0   yaw=1.55   pitch=0.12   cut   # CUT INTO the party — the snacks erupt
t=@@bar:85     pos=0.0,-0.20,0.9   dist=2.9   yaw=1.42   pitch=0.30   cut         # dive among the bouncing bitterballen (target ON the lit fire+snack cluster, look down into them)
t=@@bar:95     pos=-0.6,0.25,-2.2  dist=8.0   yaw=1.85   pitch=0.18   cut         # pull WIDE — the whole camp raves
t=@@bar:105    pos=0.5,0.00,-0.8   dist=5.0   yaw=1.35   pitch=0.20   cut
t=@@outro      pos=0.2,0.05,-0.6   dist=6.6   yaw=1.45   pitch=0.16
t=@@bar:120    pos=-0.3,0.10,-1.5  dist=8.0   yaw=1.55   pitch=0.14
t=225          pos=-1.2,0.30,-3.0  dist=11.0  yaw=1.62   pitch=0.10

[sync]
# An ENERGY ARC with palette shifts so each act FEELS different: cold hush → the fire ignites the
# night (plasma) → hush as the horse walks in → THE PARTY ERUPTS (fractal rave glow) → warm afterglow
# back to the night sky for the credits. bg_dim drops (brighter) on the peaks, climbs on the hushes.
t=@@intro      flash=0.06  bg_dim=0.85  beat=0.20  exposure=0.85  bg=aurora   # cold moonlit hush
t=@@build      flash=0.15  bg_dim=0.62  beat=0.6   exposure=1.0                # the camp assembles, warming
t=@@drop       flash=0.85  bg_dim=0.38  beat=1.9   exposure=1.35  bg=plasma    # FIRE lights — the night ignites
t=@@bar:50     flash=0.45  bg_dim=0.48  beat=1.4   exposure=1.15               # riding the drop
t=@@breakdown  flash=0.15  bg_dim=0.72  beat=0.5   exposure=0.85  bg=aurora    # hush — the horse ambles in
t=@@bar:65     flash=0.08  bg_dim=0.80  beat=0.3   exposure=0.80               # quietest — anticipation
t=@@climax     flash=0.95  bg_dim=0.28  beat=2.3   exposure=1.75  bg=fractal   # THE PARTY ERUPTS — rave glow
t=@@bar:95     flash=0.70  bg_dim=0.34  beat=2.0   exposure=1.55  bg=fractal   # peak sustains
t=@@bar:105    flash=0.55  bg_dim=0.40  beat=1.7   exposure=1.40               # party rolls on
t=@@outro      flash=0.30  bg_dim=0.58  beat=1.0   exposure=1.05  bg=aurora    # warm afterglow → night for the credits
t=@@bar:125    flash=0.0   bg_dim=0.22  beat=0.4   exposure=0.85               # fade to close

[caption]
# (The emotional dip is now shown, not told: the deFEEST wordmark visibly LEAVES at the breakdown +
#  RETURNS on the climax — no on-screen caption. Only the end-credits scroll remains.)
# Scrolling credits — each starts below-screen (fy=1.2), scrolls upward centred
screentext:deFEEST fun and games  in @@outro        out @@bar:124  at 0,1.2  center  size 22  scroll 0.05  fade 1.0
screentext:PonyCamp 2026          in @@outro+2bar   out @@bar:124  at 0,1.2  center  size 22  scroll 0.05  fade 1.0
screentext:6-9 augustus 2026      in @@outro+4bar   out @@bar:124  at 0,1.2  center  size 22  scroll 0.05  fade 1.0
