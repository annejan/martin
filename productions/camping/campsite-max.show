# martin — NIGHT CAMPSITE MAX EDITION
# Same moonlit tableau, MAXED: denser camp, Lissajous bitterballen,
# scrolling credits, aggro camera, sync+exposure.
#   MARTIN_SHOW=productions/camping/campsite-max.show cargo +nightly run --release
#   MARTIN_SHOW=productions/camping/campsite-max.show ./record.sh campsite-max.mp4

[settings]
kind           = demo
score          = productions/camping/score.txt
budget         = 140000
morph_count    = 15000
bg             = aurora
post           = chroma
cam_pump       = 0.15
particles      = embers
particle_count = 666
particle_at    = @@drop
particle_origin = 0,-0.3,0.3
particle_spread = 1.8,1.0,1.8
bg_dim         = 0.6

[stage]
# ── BACKDROP: ridge, moon, field, faint nebula, a few stars ──
splat:mountains.ply @0,-1.2,-12.0  *11,3,9   ~fade  in intro  count:14000
splat:moon.ply      @0.8,3.0,-50.0 *7.0      spin 0,3,0  drift 0.05,0.006,0  ~fade  in intro  count:5000
splat:terrain.ply   @0,-1.5,-7     *13,4.5,11 ~fade  in intro  count:28000
splat:galaxy.ply    @0,2.8,-8.0    *6,1,6    alpha:0.08  drift 0.002,0,0  ~fade  in intro  count:6000
splat:star.ply      @2.5,2.5,-9    *0.3   alpha:0.4   spin 4,6,3  bob 0.10  ^pulse:0.7  path:orbit:0.2,0.15,0.25   ~fade  in intro  count:2000  # twinkle: beat-pulse + slow spin + gentle orbit drift
splat:star.ply      @-2.0,2.0,-10  *0.25  alpha:0.35  spin 5,3,4  bob 0.08  ^pulse:0.6  path:orbit:0.18,0.12,0.3   ~fade  in intro  count:1500
splat:star.ply      @3.0,1.5,-8    *0.2   alpha:0.3   spin 3,7,2  bob 0.12  ^pulse:0.8  path:orbit:0.15,0.1,0.2    ~fade  in intro  count:1000

# ── TENTS: pitched well clear of each other and the trees ──
splat:tent.ply      @-2.8,-1.11,0.7  *0.85  sway 0,4,0   ~fade  in build  count:9000
splat:tent.ply      @4.0,-1.08,1.2   *0.55  rot 0,30,0  sway 0,3,0  ~fade  in drop  count:5000

# ── CAMPFIRE: flame in the centre, embers fly. ^turbulence churns it + beat: makes it FLICKER/leap on
#    the kick (a live fire, not a static cone); bob lifts it, more splats = a fuller flame body. ──
splat:flame.ply     @0.0,-0.44,0.3   *0.72  bob 0.11  ^turbulence:0.72  ~fade  in drop  count:3600

# ── GROVE: spaced wide, well clear of tents ──
splat:pine.ply      @3.0,-0.31,0.5   *1.2   sway 0,8,0  bob 0.04   ~fade  in build  count:7000  # tall front
splat:pine.ply      @3.8,-0.56,-0.6  *0.55  sway 0,13,0  bob 0.03  ~fade  in build  count:4000  # short sapling
splat:pine.ply      @1.7,-0.44,-1.7  *0.8   sway 0,5,0  bob 0.05   ~fade  in climax  count:6000
splat:pine.ply      @-1.5,-0.38,-1.9 *1.15  sway 0,9,0  bob 0.04   ~fade  in climax  count:7000  # tall back-left
splat:pine.ply      @-3.5,-0.31,-0.9 *0.65  sway 0,7,0  bob 0.03   ~fade  in climax  count:4500  # short
splat:pine.ply      @-4.0,-0.48,1.2  *0.9   sway 0,6,0  bob 0.04   ~fade  in drop
# caravan.glb (PD, AJB) — the camper parked in the camp; assembles with the tent in the build. rot/scale
# render-checked per the new-asset rule.
mesh:caravan.glb    @-2.7,-0.55,-0.4 *0.7   rot 0,35,0  disk:0.4  ~fade  in build   count:35000

# ── WORDMARK: the emotional spine. deFEEST opens the camp (build), then LEAVES at the breakdown
#    (the "zonder deFEEST is het kut" dip — the camp goes dark + empty), then RETURNS bigger + bright
#    on the climax (~explode = the joyful comeback) — the party only erupts WITH deFEEST back. ──
text:deFEEST        @-1.7,0.7,1.0 *0.42  ~pen-write  tint:brand  in build  out breakdown
text:deFEEST        @-1.4,0.9,1.0 *0.55  ~outline    font:defeest  tint:brand  bob 0.05  in climax  # the SECOND coming — outline draw-on

# ── STORY: horse walks in, party erupts with flying bitterballen ──
mesh:paard.glb  @-9.0,-0.5,-4.5  *0.9  count:40000  rot 0,180,0  travel:-2.2,-0.868,-4.5@breakdown,16  sway 0,4,0  bob 0.05  ^pulse:0.4  ~fade  in breakdown
mesh:bier.glb       @1.6,-0.55,0.9  *0.45  alpha:0.16  bob 0.04  spin 0,45,0  ~fade  in climax
# ── 5 bitterballen: a BOUNDED Lissajous weave near the fire (was `drift` — constant velocity from
#    t=0, so by the climax entry (~128s) they'd flown right out of frame; path:liss stays put + tumbles).
mesh:bitterbal.glb  @-0.9,-0.32,1.0 *0.20  path:liss:0.35,0.25,0.3,2,3,1,0.45  bob 0.10  ^pulse:0.6  spin 19,37,13  tint:fry  ~fade  in climax
mesh:bitterbal.glb  @0.8,-0.30,1.2  *0.18  path:liss:0.3,0.3,0.25,3,1,2,0.50   bob 0.12  ^pulse:0.6  spin 23,29,17  tint:fry  ~fade  in climax
mesh:bitterbal.glb  @0.1,-0.10,1.5  *0.16  path:liss:0.28,0.22,0.32,1,3,2,0.40 bob 0.12  ^pulse:0.6  spin 31,13,41  tint:fry  ~fade  in climax
mesh:bitterbal.glb  @-1.5,-0.25,0.5 *0.22  path:liss:0.32,0.28,0.3,2,1,3,0.55  bob 0.10  ^pulse:0.5  spin 11,23,7   tint:fry  ~fade  in climax
mesh:bitterbal.glb  @1.8,-0.28,0.3  *0.15  path:liss:0.3,0.26,0.28,3,2,1,0.48  bob 0.12  ^pulse:0.7  spin 17,43,29  tint:fry  ~fade  in climax
mesh:paard.glb      @1.0,-0.775,-4.0 *0.8   count:40000  rot 0,200,0  sway 0,5,0  bob 0.05  ^pulse:0.4  tint:fry  ~fade  in climax
splat:doggo.ply     @1.96,-1.16,1.2  *0.5   rot 0,-16,0  sway 0,7,0  bob 0.04  travel:1.8,-1.0,1.2@climax,14  ~fade  in climax
# Festival title card — drawn EARLY (from the drop, as the camp comes alive) in OUTLINE (neon draw-on),
# held to the outro. Title + subtitle stacked, centre-upper, clear of the deFEEST wordmark (left).
text:PonyCamp       @0,1.25,1.0    *0.5   ~fade  font:defeest  tint:brand  bob 0.05  in build  out outro  # filled deFEEST font (not outline)
text:Fun en Games   @0,0.78,1.0   *0.3   ~fade  font:defeest  tint:brand  bob 0.04  in build  out outro

# ── BARNYARD: the camp's resident animals finish off PonyCamp. Two goats graze as the camp assembles
#    (build); a peacock struts in when the fire lights (drop); and a rare WHITE peacock (tint:white —
#    albino, the shape carries it) parades for the party on the climax. Grazing = sway+bob; the peacocks
#    strut (slow yaw-spin) + bounce on the kick (^pulse). All front-foreground + grounded, clear of the
#    tents/pines/snacks. ──
mesh:geit.glb  @-2.4,-1.05,2.1  *0.5   rot 0,-4,0   sway 0,5,0  bob 0.05               ~fade  in build
mesh:geit.glb  @2.6,-1.24,2.0   *0.45  rot 0,-74,0  sway 0,6,0  bob 0.06               ~fade  in build
mesh:pauw.glb  @-1.79,-1.3,-0.57  *0.55  rot 0,55,0   spin 0,16,0  bob 0.05  ^pulse:0.4  ~fade  in drop
mesh:pauw.glb  @0.75,-1.33,-1.98  *0.6   rot 0,-55,0  spin 0,12,0  bob 0.06  ^pulse:0.6  tint:white  ~fade  in drop
# cavia's (guinea pigs) — tiny camp critters near the tent, social pair; nervous twitch via ^jitter.
mesh:cavia.glb @-1.15,-1.12,1.45  *0.26  rot 0,28,0   sway 0,10,0  bob 0.035  ^jitter:0.4  ~fade  in build
mesh:cavia.glb @-0.78,-1.10,1.55  *0.22  rot 0,-18,0  sway 0,12,0  bob 0.04   ^jitter:0.4  ~fade  in build

# ── CREDITS: Bevy UI scrolling captions (see [caption] below) ──

[camera]
t=@@intro      pos=1.3,0.25,0.3    dist=9.5   yaw=1.00   pitch=0.16
t=@@bar:4      pos=1.0,0.10,0.2    dist=7.5   yaw=1.20   pitch=0.18
t=@@build      pos=0.6,-0.20,0.4   dist=5.4   yaw=1.45   pitch=0.20
t=@@bar:12     pos=0.4,-0.40,0.5   dist=4.2   yaw=1.50   pitch=0.15
t=@@drop       pos=0.3,-0.60,0.6   dist=2.5   yaw=1.55   pitch=0.08   cut
t=@@bar:30     pos=-0.3,-0.50,0.4  dist=3.2   yaw=1.75   pitch=0.12
t=@@bar:45     pos=0.6,-0.40,0.3   dist=3.8   yaw=1.35   pitch=0.14
t=@@bar:52     pos=-0.4,-0.30,0.2  dist=4.5   yaw=1.80   pitch=0.16
t=@@breakdown  pos=-1.3,-0.35,0.4  dist=6.8   yaw=2.05   pitch=0.14
t=@@bar:65     pos=-1.5,-0.30,0.3  dist=7.5   yaw=2.10   pitch=0.12
t=@@climax     pos=-0.6,0.05,-1.2  dist=5.0   yaw=1.55   pitch=0.12   cut   # CUT INTO the party — the snacks erupt
t=@@bar:85     pos=0.5,-0.15,-0.3  dist=3.6   yaw=1.10   pitch=0.16         # dive among the bouncing bitterballen
t=@@bar:95     pos=-0.6,0.25,-2.2  dist=8.0   yaw=1.85   pitch=0.18         # pull WIDE — the whole camp raves
t=@@bar:105    pos=0.5,0.00,-0.8   dist=5.0   yaw=1.35   pitch=0.20
t=@@outro      pos=0.2,0.05,-0.6   dist=6.6   yaw=1.45   pitch=0.16
t=@@bar:120    pos=-0.3,0.10,-1.5  dist=8.0   yaw=1.55   pitch=0.14
t=225          pos=-1.2,0.30,-3.0  dist=11.0  yaw=1.62   pitch=0.10

[sync]
# An ENERGY ARC with palette shifts so each act FEELS different: cold hush → the fire ignites the
# night (plasma) → hush as the horse walks in → THE PARTY ERUPTS (fractal rave glow) → warm afterglow
# back to the night sky for the credits. bg_dim drops (brighter) on the peaks, climbs on the hushes.
t=@@intro      flash=0.06  bg_dim=0.85  beat=0.20  exposure=0.85  bg=aurora   # cold moonlit hush
t=@@build      flash=0.15  bg_dim=0.62  beat=0.6   exposure=1.0                # the camp assembles, warming
t=@@drop       flash=0.85  bg_dim=0.38  beat=1.9   exposure=1.35  bg=plasma    # FIRE lights — the night ignites
t=@@bar:50     flash=0.45  bg_dim=0.48  beat=1.4   exposure=1.15               # riding the drop
t=@@breakdown  flash=0.15  bg_dim=0.72  beat=0.5   exposure=0.85  bg=aurora    # hush — the horse ambles in
t=@@bar:65     flash=0.08  bg_dim=0.80  beat=0.3   exposure=0.80               # quietest — anticipation
t=@@climax     flash=0.95  bg_dim=0.28  beat=2.3   exposure=1.75  bg=fractal   # THE PARTY ERUPTS — rave glow
t=@@bar:95     flash=0.70  bg_dim=0.34  beat=2.0   exposure=1.55  bg=fractal   # peak sustains
t=@@bar:105    flash=0.55  bg_dim=0.40  beat=1.7   exposure=1.40               # party rolls on
t=@@outro      flash=0.30  bg_dim=0.58  beat=1.0   exposure=1.05  bg=aurora    # warm afterglow → night for the credits
t=@@bar:125    flash=0.0   bg_dim=0.22  beat=0.4   exposure=0.85               # fade to close

[caption]
# (The emotional dip is now shown, not told: the deFEEST wordmark visibly LEAVES at the breakdown +
#  RETURNS on the climax — no on-screen caption. Only the end-credits scroll remains.)
# Scrolling credits — each starts below-screen (fy=1.2), scrolls upward centred
screentext:deFEEST fun and games  in @@outro        out @@bar:124  at 0,1.2  center  size 22  scroll 0.05  fade 1.0
screentext:PonyCamp 2026          in @@outro+2bar   out @@bar:124  at 0,1.2  center  size 22  scroll 0.05  fade 1.0
screentext:6-9 augustus 2026      in @@outro+4bar   out @@bar:124  at 0,1.2  center  size 22  scroll 0.05  fade 1.0
