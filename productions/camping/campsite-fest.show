# martin — FESTIVAL CAMP (variant): a crowded field — a row of tents, a little forest of pines, a big
# bonfire, lots of embers, a fractal-sky rave glow. Busier + warmer than the lone night camp. Same
# assemble-over-the-track animation. Procedural splatgen shapes only.
#   MARTIN_SHOW=productions/camping/campsite-fest.show cargo +nightly run --release

[settings]
kind           = demo
score          = productions/camping/score.txt
budget         = 80000           # more objects → trim per-object splats
bg             = fractal         # a Kaliset rave-sky glow
particles      = embers
particle_count = 520             # a sky full of sparks
bg_dim         = 0.55

[stage]
splat:terrain.ply   @0,-1.25,0      *2.6   spin 0,4,0    ~fade  in intro       # the field
splat:moon.ply      @1.7,1.4,-2.2   *0.5   spin 0,3,0    ~fade  in intro
splat:tent.ply      @-1.5,-0.45,0.1 *0.7   sway 0,8,0    ~fade  in build       # a ROW of tents
splat:tent.ply      @0.1,-0.5,0.4   *0.8   sway 0,8,0    ~fade  in build
splat:tent.ply      @1.5,-0.45,-0.1 *0.7   sway 0,8,0    ~fade  in climax
splat:flame.ply     @0,-0.5,0.9     *0.7   bob 0.07  ^turbulence:0.4  ~fade  in drop  # a big bonfire
splat:pine.ply      @-2.0,-0.4,-0.5 *0.8   sway 0,7,0    ~fade  in build       # a little forest
splat:pine.ply      @2.0,-0.4,-0.4  *0.85  sway 0,7,0    ~fade  in climax
splat:pine.ply      @-1.0,-0.35,-0.8 *0.6  sway 0,7,0    ~fade  in climax

[camera]
t=@@intro      pos=0,0.4,0    dist=3.4   yaw=1.25   pitch=0.26
t=@@drop       pos=0,0.12,0   dist=2.1   yaw=1.55   pitch=0.12   # dive into the bonfire
t=@@climax     pos=0,0.25,0   dist=3.0   yaw=1.05   pitch=0.20   # sweep the crowded field
t=@@outro      pos=0,0.35,0   dist=3.2   yaw=1.45   pitch=0.26

[sync]
t=@@intro      flash=0.15  bg_dim=0.6   beat=0.5
t=@@drop       flash=0.6   bg_dim=0.4   beat=1.7      # bonfire + full rave energy
t=@@climax     flash=0.45  bg_dim=0.4   beat=1.4
t=@@outro      flash=0.2   bg_dim=0.55  beat=0.8
