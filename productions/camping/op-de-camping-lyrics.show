# martin — "OP DE CAMPING" · the SIMPLE lyrics demo (karaoke cut).
# All of Ome Henk's 1995 lyrics on screen as a timed [caption] track, over a lean morphing-splat
# backbone with section-cued backdrop shaders. Ends on a REAL explosion: the splat bursts apart on
# the outro bang, a shockwave ring + lightning backdrop flash, then it all dies out to black.
#
#   MARTIN_SHOW=productions/camping/op-de-camping-lyrics.show cargo +nightly run --release
#   MARTIN_SHOW=productions/camping/op-de-camping-lyrics.show ./record.sh op-de-camping-lyrics.mp4
#
# Lyrics map to the score's vocal structure: build/breakdown = couplet (verse), drop/climax/outro =
# chorus ("Op de camping"). 140 BPM, 133 bars, ~228s. Caption anchors are MUSICAL (@@bar:N).

# --- settings ---
kind   = demo
budget = 120000                       # lean; lower MARTIN_MORPH_COUNT for a full 1080p record (exit:explode = extra cloud → iGPU OOM)
ply    = assets/aegg-baked.ply        # .ply root = assets/ so `splat:` filenames resolve
score  = productions/camping/score.txt
bg_dim = 0.35                         # keep backdrops behind the captions, readable
flash  = 0.5                          # bloom pop on the @@anchored cuts
beat   = 0.3                          # subtle beat-reaction
pw_splat = 0.004
# RENDER THIS SHOW WITH:  MARTIN_FADE_OUT=1.7 ./record.sh out.mp4
# — keeps the picture LIT through the ~226s boom then a fast 1.7s fade (pairs with the score's
#   endfade=1.6 audio die-out). record.sh's ffmpeg is a separate process, so it reads the env directly
#   (the [settings] block only reaches the martin binary, not the mux step).

# --- the splat backbone: one cloud morphing through the sections, backdrop swapping per section.
#     Last lyric shot EXPLODES (exit:explode) into the trailing shockwave blast = the finale. ---
[reel]
glb:defeest.glb        @@intro      @11,3                              backdrop:plasma   # logo drifts in over the intro
splat:aegg.ply         @@build      @6,2     ~morph     ^twist         backdrop:grid     # verse 1 — the camp builds
splat:supershape.ply   @@drop       @8,1.5   ~morph     ^wave          backdrop:kaleido  # chorus 1 — party morph
splat:doggo.ply        @@breakdown  @10,2.5  ~morph     ^ripple        backdrop:stars    # verse 2 — night, "tent staat in de brand"
splat:supershape.ply   @@climax     @8,1.5   ~morph     ^wave          backdrop:kaleido  # chorus 2 — peak party
splat:galaxy.ply       @@outro      @8,1.6   ~morph     ^turbulence  exit:explode  backdrop:bolt   # outro — spins up, then BURSTS outward (peak spread ~226.0s, ON the audio boom)
splat:knot.ply         @@bar:132    @5,2     ~shockwave         flash:1.0  backdrop:bolt   # trailing trigger: galaxy bursts 1.5s before this (224.8→226.3); shockwave ring + white flash on the bang

# --- camera: front-facing (captions are screen-space; this frames the splats). Push in over the
#     song, snap back + rattle on the explosion, then settle as it dies out. ---
[camera]
t=0.0     pos=0,0,0    dist=3.0   yaw=1.45   pitch=0.10   # intro: logo floats in
t=13.7    pos=0,0,0    dist=2.6   yaw=1.50   pitch=0.14   # build: verse 1
t=42.9    pos=0,0,0    dist=2.0   yaw=1.40   pitch=0.18   # drop: push in for the chorus
t=70.0    pos=0.3,0,0  dist=2.2   yaw=1.60   pitch=0.18   # arc across the party
t=99.4    pos=0,0,0    dist=3.0   yaw=1.45   pitch=0.08   # breakdown: fall back, night
t=128.6   pos=0,0,0    dist=1.9   yaw=1.50   pitch=0.20   # climax: slam in
t=160.0   pos=-0.3,0,0 dist=2.1   yaw=1.30   pitch=0.20   # ride the high
t=185.1   pos=0,0,0    dist=2.4   yaw=1.45   pitch=0.12   # outro: hold on the spinning galaxy
t=223.0   pos=0,0,0    dist=2.3   yaw=1.45   pitch=0.14   # tight as it spins up + starts to fling out
t=225.8   pos=0,0,0    dist=3.5   yaw=1.45   pitch=0.12   # THE BLAST — snap WIDE on the peak spread (on the boom), screen still lit
t=228.0   pos=0,0,0    dist=3.8   yaw=1.45   pitch=0.10   # die out to black over the dying debris

# --- the finale pop: brighten the bolt backdrop + bloom on the blast, then settle for the die-out ---
[sync]
t=@@bar:108     flash=0.5  bg_dim=0.35  exposure=1.0
t=@@bar:131     flash=0.7  bg_dim=0.6   exposure=1.3   # lift into the blast
t=@@bar:132     flash=1.0  bg_dim=0.9   exposure=1.7   # SPIKE on the boom (~226.3s)
t=@@bar:133     flash=0.0  bg_dim=0.15  exposure=0.7   # die out to black

# --- ALL the lyrics (Ome Henk · "Op de camping" · 1995). Bottom-center, timed to the bars. ---
[caption]
# intro
screentext:OP DE CAMPING                                              in @@intro    out @@build      at 0.5,0.5   size 72  center  fade 1.0
screentext:Ome Henk · 1995                                            in @@bar:3    out @@build      at 0.5,0.62  size 28  center  fade 1.0

# VERSE 1  (build)
screentext:Elk jaar gaan we lekker met z'n alle naar de camping toe   in @@bar:8    out @@bar:12     at 0.5,0.84  size 32  center  fade 0.4
screentext:Na een jaar werken wil je ontspanning, oh oh wat zijn we moe in @@bar:12  out @@bar:16     at 0.5,0.84  size 32  center  fade 0.4
screentext:Op de camping zie je de buren uit de straat (henkie)        in @@bar:16   out @@bar:20     at 0.5,0.84  size 32  center  fade 0.4
screentext:Pak ik gauw een biertje, want je bent gauw uitgepraat       in @@bar:20   out @@bar:25     at 0.5,0.84  size 32  center  fade 0.4

# CHORUS 1  (drop)
