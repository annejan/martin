# martin — ALLES IS EEN BITTERBAL 🟤🎆: ONE flowing 6-act demo. A morphing hero cloud journeys
# (cosmos → the whole world → the BITTERBAL reveal → balls up → deFEEST logo) while a STAGGERED,
# COPRIME swarm lives in front of it the whole way — every bitterbal on its own lissajous, no two
# ever in sync. reel + stage run together on one camera arc. 89s, 100% local assets.
#
#   live:    MARTIN_LOOP=1 MARTIN_SHOW=productions/bitterbal/alles.show cargo +nightly run --release
#   preview: TMPDIR=~/.cache/martin-render MARTIN_RES=1280x720 MARTIN_PREVIEW_FPS=30 \
#            MARTIN_SHOW=productions/bitterbal/alles.show ./record.sh /tmp/alles.mp4

[settings]
kind         = demo
pair         = match
score        = productions/cities/score.txt
ply          = assets/sphere.ply
budget       = 160000
bg           = stars
post         = chroma
cam_pump     = 0.28
flash        = 0.25
bg_dim       = 0.5

[reel]
splat:galaxy.ply    @@intro     @4,2          ~fade                                            backdrop:stars
splat:doggo.ply     @@build     @1.4,0.4,0.1  ~morph  beat:0.8                                 backdrop:grid
splat:train.ply                 @0.6,0.45,0.2 ~morph                                           backdrop:grid
splat:truck.ply                 @0.6,0.45,0.2 ~morph                                           backdrop:grid
splat:martin.ply                @1.0,0.5,0.15 ~morph                                           backdrop:stars
splat:austin_tight.ply          @0.7,0.4,0.2  ~morph                                           backdrop:stars
splat:nyc_tight.ply             @0.7,0.4,0.2  ~morph                                           backdrop:grid
mesh:bitterbal.glb  @@drop      @4,1.5        ~shockwave  ease:snap  tint:fry  flash:0.9  beat:1.8  backdrop:stars
mesh:bitterbal.glb  @@breakdown @3,2          ~morph  ^turbulence:0.3  tint:fry                backdrop:stars
mesh:bitterbal.glb  @@climax    @4,2          ~ball  tint:fry  flash:0.6  beat:1.9  ^turbulence:0.15  backdrop:stars
mesh:defeest.glb    rot:180,0,0 @@outro       @4,2          ~morph                             backdrop:stars

[stage]
# ── INTRO (bars 1-4) ──────────────────────────────────  staggered fade-in, clears into the drop
mesh:bitterbal.glb @1.9,0.30,2.4 *0.16 spin 13,29,17 drift -0.012,0.004,-0.010 path:liss:0.9,0.7,0.8,3,2,5,0.22 tint:fry count:2500 ~fade in bar:0 out drop
mesh:bitterbal.glb @-2.6,-0.85,2.7 *0.14 spin 19,33,11 drift 0.014,0.006,-0.012 path:liss:1.2,0.9,1.0,5,7,2,0.30 tint:fry count:2500 ~fade in bar:1 out drop
mesh:bitterbal.glb @2.7,1.15,1.9 *0.20 spin 27,15,31 drift -0.016,-0.005,-0.008 path:liss:1.5,1.1,1.3,7,3,11,0.18 tint:fry count:3000 ~fade in bar:2 out drop
mesh:bitterbal.glb @-1.4,0.95,2.9 *0.18 spin 31,23,13 drift 0.010,-0.006,-0.014 path:liss:0.8,1.0,0.9,2,5,3,0.27 tint:fry count:2800 ~fade in bar:3 out drop

# ── BUILD (bars 5-10) ─────────────────────────────────  fullest swarm, all clear before the drop reveal
mesh:bitterbal.glb @1.6,1.7,0.4 *0.16 spin 23,15,31 path:liss:1.4,1.0,1.2,3,2,5,0.31 tint:fry count:2500 ~explode in bar:4 out drop
mesh:bitterbal.glb @-1.4,0.5,0.8 *0.20 spin 17,11,29 path:liss:1.6,1.3,1.5,5,7,2,0.44 tint:fry count:3000 ~morph in bar:5 out drop
mesh:aegg.glb @-2.0,-0.7,1.2 *0.5 spin 9,15,7 path:liss:2.0,1.5,1.8,2,3,7,0.23 count:6000 ~swirl in bar:5 out drop
mesh:bitterbal.glb @0.8,2.2,-0.4 *0.13 spin 31,19,13 path:liss:1.2,1.4,1.1,7,3,11,0.27 tint:fry count:2200 ~funnel in bar:6 out drop
mesh:bitterbal.glb @1.9,-0.9,0.6 *0.18 spin 27,23,37 path:liss:1.7,0.9,1.4,2,5,3,0.53 tint:fry count:2800 ~explode in bar:7 out drop
mesh:bitterbal.glb @-0.6,1.9,0.2 *0.15 spin 13,29,41 path:liss:1.3,1.6,1.3,11,2,7,0.38 tint:fry count:2500 ~morph in bar:8 out drop

# ── DROP (bars 11-22) ─────────────────────────────────  the BITTERBAL reveal: spinning balls + the line, then clears for the hush
text:de wereld is een bitterbal @-2.4,2.6,0.6 *0.62 tint:brand sway 0,6,0 path:liss:0.12,0.08,0.06,3,2,5,0.5 count:14000 ~pen-write in bar:10 out breakdown
mesh:bitterbal.glb @2.2,0.4,0.9 *0.42 tint:fry spin 12,28,7 path:liss:0.35,0.22,0.18,5,7,2,1.4 count:7000 ~ball in bar:11 out breakdown
mesh:bitterbal.glb @-1.8,-0.8,1.4 *0.38 tint:fry spin 9,34,15 path:liss:0.28,0.3,0.2,7,3,11,1.1 count:6500 ~ball in bar:13 out breakdown
mesh:bitterbal.glb @1.6,1.8,0.5 *0.33 tint:fry spin 18,22,11 path:liss:0.3,0.18,0.24,11,5,3,1.7 count:5500 ~explode in bar:15 out breakdown
mesh:bitterbal.glb @-0.6,1.2,2.0 *0.28 tint:fry spin 7,40,9 path:liss:0.2,0.26,0.16,2,13,7,0.9 count:4000 ~ball in bar:17 out breakdown
mesh:bitterbal.glb @0.0,-0.4,0.8 *0.16 tint:fry field:6 spin 5,30,13 path:liss:0.4,0.34,0.28,13,3,2,2.1 count:9000 ~explode in bar:19 out breakdown
mesh:aegg.glb @2.6,-1.0,1.6 *0.22 spin 11,18,5 path:orbit:1.6,0.4,1.3 count:3000 ~ball in bar:21 out breakdown

# ── BREAKDOWN (bars 23-26) ────────────────────────────  SPARSE + vulnerable: only a few slow morphers hovering
mesh:bitterbal.glb @-0.6,0.7,0.6 *0.22 spin 23,41,17 path:liss:1.8,1.2,1.6,3,2,5,0.21 tint:fry count:3500 ~morph in bar:22 out climax
mesh:bitterbal.glb @0.9,0.4,0.2 *0.20 spin 31,19,43 path:liss:2.0,1.4,1.8,5,7,2,0.17 tint:fry count:3000 ~morph in bar:23 out climax
mesh:bitterbal.glb @-1.1,1.2,1.0 *0.24 spin 13,47,29 path:liss:1.6,1.6,1.4,7,3,11,0.14 tint:fry count:3500 ~morph in bar:24 out climax
mesh:aegg.glb @1.9,1.6,0.6 *0.42 spin 9,19,7 path:liss:2.0,1.0,1.8,2,3,5,0.11 count:5500 ~morph in bar:24 out climax
mesh:bitterbal.glb @0.2,1.5,0.4 *0.19 spin 29,17,47 path:liss:1.7,1.8,1.5,3,11,5,0.19 tint:fry count:2800 ~morph in bar:25 out climax

# ── CLIMAX (bars 27-38) ───────────────────────────────  the peak: tiered field-swarms + two calm AEgg moons, all scatter into the outro
mesh:bitterbal.glb @-1.6,0.4,0.6 *0.20 field:6 spin 37,23,11 path:liss:2.6,1.8,2.4,5,7,2,0.34 tint:fry count:6000 ~explode in bar:26 out outro
mesh:bitterbal.glb @1.4,0.6,-0.5 *0.18 field:6 spin 19,43,31 path:liss:2.4,2.0,2.8,3,5,11,0.29 tint:fry count:6000 ~explode in bar:27 out outro
mesh:aegg.glb @0,0.3,0 *0.40 spin 9,17,5 path:orbit:2.4,0.5,0.22 tint:fry count:5500 ~ball in bar:28 out outro
mesh:bitterbal.glb @0.0,1.3,1.0 *0.17 field:5 spin 29,17,47 path:liss:2.0,2.6,2.2,7,11,3,0.41 tint:fry count:5000 ~explode in bar:30 out outro
mesh:bitterbal.glb @-2.7,0.7,-1.0 *0.22 field:6 spin 17,31,43 path:orbit:2.6,0.6,0.19 tint:fry count:6000 ~ball in bar:32 out outro
mesh:bitterbal.glb @2.6,-0.3,1.3 *0.15 field:7 spin 53,37,23 path:liss:1.9,1.4,1.7,2,13,5,0.47 tint:fry count:5500 ~explode in bar:33 out outro
mesh:aegg.glb @0,-0.2,0 *0.34 spin 13,7,19 path:orbit:2.8,0.35,0.16 tint:fry count:5000 ~ball in bar:34 out outro
text:de wereld is een bitterbal @-0.8,1.6,1.6 *0.78 sway 0,5,0 path:liss:0.5,0.4,0.5,3,11,13,0.18 tint:brand count:16000 ~pen-write in bar:35 out outro
mesh:bitterbal.glb @1.0,1.1,-1.0 *0.16 field:6 spin 31,19,11 path:liss:2.2,1.7,2.5,5,2,7,0.38 tint:fry count:5000 ~explode in bar:36 out outro

# ── OUTRO (bars 39-46) ────────────────────────────────  resolve: a few balls drift up + away, then the deFEEST logo (bob+sway, NEVER Y-spin) and the line
mesh:bitterbal.glb @-2.6,1.20,1.10 *0.26 spin 13,7,11 drift 0.02,0.05,0 path:liss:0.90,0.60,0.70,3,2,5,0.120 tint:fry count:3500 ~morph in bar:38
mesh:bitterbal.glb @2.4,1.45,0.90 *0.24 spin 7,11,13 drift -0.02,0.05,0 path:liss:1.10,0.50,0.85,5,3,2,0.140 tint:fry count:3500 ~morph in bar:39
mesh:bitterbal.glb @-1.4,2.20,1.40 *0.22 spin 11,13,7 drift 0.02,0.04,0 path:liss:0.80,0.70,0.60,2,5,3,0.108 tint:fry count:3000 ~morph in bar:40
mesh:aegg.glb @2.9,1.60,0.70 *0.23 spin 5,3,7 drift -0.03,0.04,0 path:liss:0.70,0.60,0.55,3,7,2,0.116 count:3500 ~morph in bar:40
mesh:defeest.glb @-0.7,0.55,2.50 *1.10 rot 180,0,0 bob 0.10 sway 0,6,0 count:20000 ~morph in bar:40
text:de wereld is een bitterbal @0.9,1.55,2.40 *0.82 bob 0.08 tint:brand count:16000 ~pen-write in bar:44

[camera]
t=@@intro      pos=1.6,0.10,0    dist=6.0   yaw=1.15   pitch=0.18
t=@@build      pos=1.0,0.05,0    dist=5.2   yaw=1.45   pitch=0.12
t=@@drop       pos=0.0,0.00,0    dist=3.8   yaw=1.45   pitch=0.06   cut
t=@@breakdown  pos=-1.4,0.15,0   dist=5.6   yaw=1.95   pitch=0.14
t=@@climax     pos=1.1,0.00,0    dist=5.2   yaw=1.55   pitch=0.18
t=@@outro      pos=0.0,0.10,0    dist=6.2   yaw=1.45   pitch=0.24

[sync]
t=@@intro      flash=0.10  bg_dim=0.45  beat=0.3                bg=stars
t=@@build      flash=0.22  bg_dim=0.50  beat=1.0
t=@@drop       flash=0.90  bg_dim=0.35  beat=1.8                bg=aurora
t=@@breakdown  flash=0.20  bg_dim=0.55  beat=0.7                bg=stars
t=@@climax     flash=0.70  bg_dim=0.35  beat=1.9                bg=stars
t=@@outro      flash=0.25  bg_dim=0.50  beat=0.7                bg=aurora