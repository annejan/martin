# martin — COSMIC SNACK 🥚→🌌→🟤: de wereld is een bitterbal, op kosmische schaal. The AEgg hatches in
# deep space, unfurls into a whole GALAXY, and on the drop the entire galaxy BALLS UP into one giant
# deep-fried bitterbal (the kill-shot reveal). It bursts into a RAIN of small bitterballen swarming on
# coprime lissajous paths through the cosmos, then everything collapses to the deFEEST logo → loops.
# ONE morphing hero cloud ([reel] = Z-safe) for the journey; the snack-rain swarm lives in [stage] IN
# FRONT of the backdrop so nothing vanishes. 100% local assets, cosmic + fun + epic.
#
#   live:    MARTIN_LOOP=1 MARTIN_SHOW=productions/bitterbal/cosmic-snack.show cargo +nightly run --release
#   preview: TMPDIR=~/.cache/martin-render MARTIN_MUTE=1 MARTIN_RES=480x270 MARTIN_PREVIEW_FPS=8 \
#            MARTIN_SHOW=productions/bitterbal/cosmic-snack.show ./record.sh /tmp/cosmic-snack.mp4

[settings]
kind     = demo
pair     = match
score    = productions/cities/score.txt   # moody A-minor synthwave (intro/build/drop/breakdown/climax/outro)
ply      = assets/sphere.ply              # asset root = assets/
budget   = 200000
bg       = aurora                          # deep cosmic sky
post     = chroma                          # RGB-split screen-tear on the kick
cam_pump = 0.30
flash    = 0.22
bg_dim   = 0.5

# THE JOURNEY — one cloud, morphing. AEgg → galaxy bloom (build) → it ALL balls into the BITTERBAL on
# the drop (kill-shot) → glistens (breakdown) → glorious peak (climax) → deFEEST logo → loops.
[reel]
splat:aegg.ply      @@intro      @5,2     ~fade                                       backdrop:stars     # THE AEgg, adrift in deep space 🥚
splat:galaxy.ply    @@build      @5,2     ~swirl  beat:0.7  ^spiral:0.25              backdrop:fractal   # …it HATCHES → unfurls into a whole galaxy 🌌
splat:star.ply                   @1.3,1.0 ~morph  ^turbulence:0.2                     backdrop:rings     # …a burst of starfire ✨ (montage glimpse — quick, fits before @@drop)
splat:helix.ply                  @1.3,1.0 ~morph  ^spiral:0.2                         backdrop:tunnel    # …cosmic DNA spirals out 🧬 (quick — @@drop fires right after)
mesh:bitterbal.glb  @@drop       @4,1.5   ~shockwave  ease:snap  tint:fry  flash:0.9  beat:1.8  backdrop:stars   # …IT'S ALL A BITTERBAL 🟤 (cosmic kill-shot reveal)
mesh:bitterbal.glb  @@breakdown  @3,2     ~morph  ^turbulence:0.3  tint:fry           backdrop:stars     # it hovers, glistening hot, while the snack-rain falls
mesh:bitterbal.glb  @@climax     @4,2     ~ball   flock:14  tint:fry  flash:0.6  beat:1.9  ^turbulence:0.4  backdrop:stars   # the peak — the giant bal balls up glorious (stars, not fractal: keep the bal the hero)
mesh:defeest.glb    rot:180,0,0  @4,2     ~morph  beat:0                              backdrop:stars     # → the deFEEST logo (rot cancels base flip-X) → loops

# THE SNACK-RAIN — async swarm IN FRONT of the reel (Z-safe). Each bitterbal rides its OWN coprime
# lissajous path through the cosmos so the swarm never repeats; they rain in on the drop, fill the
# breakdown→climax, and clear before the logo finale. count: keeps each soft. The caption lands the
# punchline upper-left on the drop (rule of thirds).
[stage]
mesh:bitterbal.glb  @1.6,0.6,2.4   *0.07  spin 19,37,13  path:liss:1.1,0.7,0.9,3,2,5,0.5  count:9000   ~explode  tint:fry  in drop   out climax    # snack-rain — front-right orbit
mesh:bitterbal.glb  @-1.9,0.4,2.6  *0.06  spin 23,29,17  path:liss:0.9,1.1,0.8,2,5,3,0.45 count:9000   ~explode  tint:fry  in drop   out climax    # snack-rain — front-left, coprime freqs
mesh:bitterbal.glb  @0.4,1.0,2.8   *0.05  spin 31,11,41  path:liss:1.2,0.6,1.0,5,3,2,0.55 count:8000   ~swarm    tint:fry  in drop   out climax    # snack-rain — high pass, never repeats
mesh:bitterbal.glb  @2.3,-0.3,2.5  *0.06  spin 13,43,29  path:liss:0.8,1.0,1.1,3,5,4,0.4  count:8000   ~swarm    tint:fry  in breakdown  out climax  # snack-rain — low sweep, joins late
text:de wereld is een bitterbal  @-0.75,0.9,1.5  *0.85  ~pen-write  tint:brand  in drop  out breakdown   # the punchline handwrites on the reveal, upper-left

# camera: orbit the hero OFF-centre (rule of thirds), low horizon. Punch IN on the drop (cut), then
# swing to frame the snack-rain, settle front-on the logo. dist ~5-6 frames the @5 morph cloud + cosmos.
[camera]
t=@@intro      pos=1.6,0.10,0    dist=6.2   yaw=1.15   pitch=0.16   # AEgg on the LEFT third, cosmos right
t=@@build      pos=1.0,0.05,0    dist=5.4   yaw=1.50   pitch=0.12   # the galaxy blooms, orbiting right
t=@@drop       pos=0.0,0.00,0    dist=3.8   yaw=1.45   pitch=0.06   cut   # CUT: punch onto the reveal (kill-shot)
t=@@breakdown  pos=-1.4,0.15,0   dist=5.6   yaw=1.95   pitch=0.14   # SWITCH sides: bitterbal on the right third, rain falling
t=@@climax     pos=1.1,0.00,0    dist=5.2   yaw=1.55   pitch=0.18   # grand, the glorious spin + swarm
t=@@outro      pos=0.0,0.10,0    dist=6.2   yaw=1.45   pitch=0.24   # settle front-on the logo → loop

[sync]
t=@@intro      flash=0.10  bg_dim=0.45  beat=0.3                # cosmic calm
t=@@build      flash=0.22  bg_dim=0.5   beat=1.0                # the hatch — energy + per-shot beats
t=@@drop       flash=0.9   bg_dim=0.35  beat=1.8                # THE REVEAL — full kick, bloom, chroma
t=@@breakdown  flash=0.2   bg_dim=0.55  beat=0.7                # hush, it glistens, snacks rain
t=@@climax     flash=0.7   bg_dim=0.35  beat=1.9                # peak
t=@@outro      flash=0.25  bg_dim=0.5   beat=0.7                # ease to the logo + loop
