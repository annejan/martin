# martin — BITTERBALZWERM 🟤🌀: a swarm of 26 deep-fried bitterballen, each weaving its OWN lissajous
# path at its own speed + spin — every bitterbal doet wat ie wil. Hypnotic, layered, independent.
# Showcases the per-object path: feature. mesh bitterballen = z-buffered (safe to swarm). 100% local.
#
#   live:    MARTIN_LOOP=1 MARTIN_SHOW=productions/bitterbal/zwerm.show cargo +nightly run --release
#   preview: TMPDIR=~/.cache/martin-render MARTIN_MUTE=1 MARTIN_RES=480x270 MARTIN_PREVIEW_FPS=10 MARTIN_SHOW=productions/bitterbal/zwerm.show ./record.sh /tmp/zwerm.mp4

[settings]
kind     = demo
score    = productions/cities/score.txt
ply      = assets/sphere.ply
budget   = 200000
bg       = stars
post     = chroma
cam_pump = 0.3
bg_dim   = 0.45

[stage]
# the central brand the swarm dances around (PBR mesh = z-buffered)
mesh:defeest.glb   @0,0,0   *1.1   rot 180,0,0   bob 0.10   sway 0,7,0   ~fade   in intro   count:16000   # gentle bob + small sway — a FLAT logo spinning round Y goes edge-on (invisible sliver); keep it facing camera
# the swarm — each bitterbal its own lissajous + spin (coprime freqs → never repeats)
mesh:bitterbal.glb @-3.2,-1.6,-2.2 *0.11  spin 13,29,17  path:liss:0.7,0.6,0.7,1,2,3,0.28  tint:fry  ~explode  in intro  count:2000
mesh:bitterbal.glb @-1.48,-0.98,0.52 *0.185  spin 20,34,28  path:liss:1.57,1.35,1.9,2,3,1,0.43  tint:fry  ~explode  in intro  count:2800
mesh:bitterbal.glb @0.25,-0.37,-1.16 *0.135  spin 27,39,19  path:liss:0.92,0.85,1.66,3,1,2,0.57  tint:fry  ~explode  in intro  count:2200
mesh:bitterbal.glb @1.97,0.25,1.56 *0.21  spin 34,44,30  path:liss:1.78,1.6,1.42,1,3,2,0.33  tint:fry  ~explode  in intro  count:3000
mesh:bitterbal.glb @-2.71,0.86,-0.12 *0.16  spin 41,49,21  path:liss:1.13,1.1,1.18,2,1,3,0.47  tint:fry  ~explode  in intro  count:2500
mesh:bitterbal.glb @-0.98,1.48,-1.8 *0.11  spin 18,29,32  path:liss:2.0,0.6,0.94,3,2,1,0.62  tint:fry  ~explode  in intro  count:2000
mesh:bitterbal.glb @0.74,-1.11,0.92 *0.185  spin 25,34,23  path:liss:1.35,1.35,0.7,1,2,4,0.38  tint:fry  ~explode  in intro  count:2800
