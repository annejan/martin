[camera]
t=@@intro      pos=0.6,0.2,0    dist=7.5  yaw=1.2   pitch=0.18    # the swarm wide, brand off-centre
t=@@drop       pos=0.0,0.0,0    dist=5.5  yaw=1.5   pitch=0.10    # dive into the swarm on the drop
t=@@breakdown  pos=-0.6,0.2,0   dist=7.0  yaw=1.95  pitch=0.16    # orbit the other way
t=@@climax     pos=0.5,0.0,0    dist=6.0  yaw=1.5   pitch=0.20    # the peak whirl
t=@@outro      pos=0.0,0.1,0    dist=8.0  yaw=1.45  pitch=0.24    # pull back

[sync]
# bg stays the calm starfield (a busy fractal drowned the 26-ball swarm); the kick lands via
# flash + exposure + beat + chroma, not a competing backdrop.
t=@@intro      flash=0.1   bg_dim=0.4   beat=0.4
t=@@drop       flash=0.9   bg_dim=0.3   beat=1.8   exposure=1.45
t=@@climax     flash=0.8   bg_dim=0.3   beat=1.7   exposure=1.5
t=@@outro      flash=0.2   bg_dim=0.45  beat=0.7
