# martin — "SKYLINE": an ORIGINAL uplifting-trance fly-through of four real aerial-splat cities
# (NYC · Chicago · Austin · Seattle), morphing city→city on the music. Our own composition
# (productions/skyline/score.txt), the new voice palette (hoover lead + bell arp), FFT-reactive sky.
# LOCAL captures only (Google Maps Content — ©Google credit on screen); the four *_tight.ply symlink
# from assets/ into the *_run/exports/ folders.
#   live:    MARTIN_SHOW=productions/skyline/skyline.show cargo +nightly run --release
#   preview: TMPDIR=~/.cache/martin-render MARTIN_RES=854x480 MARTIN_PREVIEW_FPS=20 \
#            MARTIN_MORPH_COUNT=260000 MARTIN_SHOW=productions/skyline/skyline.show ./record.sh /tmp/skyline.mp4
[settings]
kind          = demo
pair          = match          # nearest same-colour pairing → straight city↔city morph (no ball)
budget        = 1200000        # crisp; override MARTIN_MORPH_COUNT=260000 for previews
score         = productions/skyline/score.txt
post          = chroma
morph_stagger = 0.6            # per-splat staggered morph = DISSOLVE+reform → kills the stripey streaks
                              # (NOT a camera/deform wobble; the clean look keeps cam_pump=0 + no ^deforms)
flash         = 0.25
bg_dim        = 0.4
fft           = 1.5
cam_pump      = 0.0            # no beat-bounce on the camera — steady, clean moves

[reel]
# CLEAN: every city change is a straight ~morph — no ~shockwave blast, no ^deform wobble, no beat-pulse.
text:SKYLINE             @@intro      @6,4    ~fade   font:defeest  tint:brand            backdrop:stars
splat:nyc_tight.ply      @@build      @6,7,0  ~morph  raster:position                   backdrop:stars     # NEW YORK — rainbow grid
splat:chicago_tight.ply  @@drop       @6,7,0  ~morph                                    backdrop:aurora    # CHICAGO
splat:austin_tight.ply   @@breakdown  @6,7,0  ~morph                                    backdrop:northern  # AUSTIN — calm
splat:seattle_tight.ply  @@climax     @14,7,0 ~morph                                    backdrop:rings     # SEATTLE — climax hold
text:SKYLINE             @@outro      @5,5    ~morph  font:defeest  tint:brand            backdrop:stars     # wrap

[stage]
text:Imagery ©Google     @0,-0.42,0   *0.5    ~fade   tint:brand   in climax  out outro              # credit during Seattle

[camera]
# real captures normalize to the origin → a low, diving city camera (dist ~1, yaw ~1.5, pitch ~0.2).
t=@@intro      pos=0,0.5,0       dist=4.0   yaw=0.95  pitch=0.65               # title tiny + high in the void
t=@@build      pos=0,0.16,0      dist=1.3   yaw=1.30  pitch=0.30   cut         # dive into NYC
t=@@bar:12     pos=-0.1,0.06,0   dist=0.95  yaw=1.46  pitch=0.16               # low pass through the grid
t=@@drop       pos=0,0.12,0      dist=1.2   yaw=1.50  pitch=0.22   cut         # CHICAGO blast
t=@@bar:28     pos=0.10,0.05,0   dist=0.85  yaw=1.55  pitch=0.14               # skim the towers
t=@@breakdown  pos=0,0.13,0      dist=1.05  yaw=1.40  pitch=0.20               # AUSTIN calm
t=@@climax     pos=0,0.16,0      dist=1.0   yaw=1.45  pitch=0.26   cut         # SEATTLE dome hero
t=@@bar:60     pos=0,0.22,0      dist=1.4   yaw=1.55  pitch=0.34               # pull back
t=@@outro      pos=0,0.4,0       dist=3.4   yaw=1.10  pitch=0.55               # rise away → title

[sync]
t=@@intro      flash=0.1   bg_dim=0.7   beat=0.4   exposure=0.9   bg=stars
t=@@build      flash=0.35  bg_dim=0.5   beat=1.2   exposure=1.1   bg=stars
t=@@drop       flash=0.7   bg_dim=0.35  beat=2.0   exposure=1.45  bg=aurora
t=@@breakdown  flash=0.25  bg_dim=0.55  beat=0.8   exposure=1.0   bg=northern
t=@@climax     flash=0.7   bg_dim=0.32  beat=2.1   exposure=1.5   bg=rings
t=@@outro      flash=0.2   bg_dim=0.6   beat=0.7   exposure=1.0   bg=stars
