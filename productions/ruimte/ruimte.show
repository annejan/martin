# RUIMTE — a maximalist cosmic morph journey through abstract shapes in space
# Music: productions/cities/score.txt (124 BPM, A-minor, epic night-drive synthwave)
# Section starts: intro 0 · build 7.7 · drop 19.4 · breakdown 42.6 · climax 50.3 · outro 73.5 (s)
#
# Shows off: all backdrop types, 6+ deforms, 5 entrance effects, caption center+scroll,
# per-object lissajous paths + travel, camera cuts, sync mood, tint modes, chroma post-FX,
# mesh + text + splat compose objects. Every engine toy.

[settings]
kind         = demo
pair         = match
score        = productions/cities/score.txt
ply          = assets/galaxy.ply
budget       = 150000
bg           = stars
post         = chroma
cam_pump     = 0.45              # bigger kick-lunge — the camera punches on every kick
flash        = 0.0
bg_dim       = 0.5
beat         = 1.0

# ── THE MORPH JOURNEY ──────────────────────────────────────────────────────────
# Each part is a shot in the sequence: one cloud morphs into the next.
#   @@anchor  @hold,morph[,bulge]  ~entrance  ^deform  backdrop:TYPE  tokens
[reel]
# ── INTRO (bars 0-3, 7.7s) ── Ontwaken: a galaxy IGNITES from black, camera already pushing
splat:galaxy.ply              @@intro    @4,1.5    ~fade                    backdrop:stars     rot:0,-0.12,0

# ── BUILD (bars 4-9, 11.6s) ── Vorming: snaps into a star, twisting hard
splat:star.ply                @@build    @4,2      ~morph   ^twist:0.6      backdrop:stars   beat:1.4   rot:0,0.2,0   flash:0.3

# ── DROP (bars 10-21, 23.2s) ── EXPLOSIE: each shape BLASTS in and SLAMS on the kick (ease:snap),
# discrete bursts instead of slow flowing morphs — fast, punchy, a new shape every ~2 bars.
splat:helix.ply               @@bar:10   @1.5,0.9  ~shockwave  ease:snap  ^spiral:0.4     backdrop:stars    tint:brand    beat:1.7   flash:0.7
splat:knot.ply                @@bar:12   @1.5,0.8  ~explode    ease:snap  ^turbulence:0.6 backdrop:tunnel   tint:fry      beat:1.9   flash:0.6
splat:supershape.ply          @@bar:14   @1.5,0.9  ~shatter    ease:snap  ^wave:0.4       backdrop:stars   tint:rainbow  beat:1.8   flash:0.6
splat:mobius.ply              @@bar:16   @1.5,0.8  ~vortex     ease:snap  ^twist:0.5      backdrop:stars    tint:brand    beat:1.8   flash:0.5
splat:sphere.ply              @@bar:18   @1,0.7    ~implode    ease:snap                  backdrop:stars   tint:rainbow  beat:1.7   flash:0.6
splat:galaxy.ply              @@bar:20   @1.5,0.9  ~explode               ^turbulence:0.8 backdrop:stars                  flash:1.0  beat:2.3

# ── BREAKDOWN (bars 22-25, 7.7s) ── Stilte: black, the title SLAMS in (the one breather)
text:RUIMTE                   @@bar:22   @5,1      ~pen-write               backdrop:off       beat:0.6   rot:0,0,0

# ── CLIMAX (bars 26-37, 23.2s) ── GROOTS: a grand explosive parade (was ONE held galaxy = saai).
# Five shapes blast in on the kick across the finale — the energy keeps climbing, not coasting.
splat:galaxy.ply              @@climax   @2,1.2    ~shockwave  ease:snap  ^turbulence:0.8 backdrop:stars    tint:brand    flash:0.9  beat:2.1
splat:supershape.ply          @@bar:28   @2,1      ~explode    ease:snap  ^wave:0.5       backdrop:stars   tint:rainbow  beat:2.1   flash:0.7
splat:knot.ply                @@bar:31   @2,1      ~shatter    ease:snap  ^turbulence:0.7 backdrop:stars   tint:fry      beat:2.2   flash:0.7
splat:star.ply                @@bar:34   @2,1      ~explode    ease:snap  ^twist:0.7      backdrop:stars    tint:brand    beat:2.3   flash:1.0
splat:galaxy.ply              @@bar:36   @1.5,1    ~vortex                ^turbulence:0.9 backdrop:stars   tint:rainbow  beat:2.1

# ── OUTRO (bars 38-45, 15.5s) ── Vertrek: signature, credits scroll, fade
text:deFEEST                  @@outro    @10,2     ~pen-write               backdrop:stars     beat:1.0

# ── STAGE OBJECTS (parallel compose layer) — DEEP-SPACE COMPOSITION ─────────────
[stage]
# The reel morph is the HERO at origin (spans ~±1). Everything here lives FAR out in distinct Z layers
# so the void reads as vast 3D space, not a cluttered pile on the centre. The bg=stars / backdrop:* are
# fullscreen SHADERS (no cloud depth-sort), so props are free to sit anywhere in Z. Rule: keep every
# prop's centre ≥ ~3 units from the origin (clear of the hero) and trajectories OUT of frame-centre.

# DEEP LANDMARKS — big + clearly visible, distant enough for parallax. Saturn (early) back-LEFT and the
# Moon (later) back-RIGHT anchor the cosmos behind the hero on opposite sides without crowding it.
splat:saturn.ply  @-3.2,1.6,3.6   *1.4   rot 0,0,0   spin 0,3,0   alpha:0.92   ~fade   in @@build    out @@bar:22
splat:moon.ply    @3.2,1.5,3.6    *1.2   spin 0,4,0  alpha:0.9                ~fade   in @@drop     out @@outro

# ROCKET LAUNCHES — streak UP past the hero: start low in frame (y -2.5) just BESIDE the morph (x ±1.4
# = clear of the hero at ±1, no overlap), climb straight up + slightly back, out the top. The small x
# offset keeps them on-screen as the camera orbits while the big vertical travel is the readable action.
# rocket nose points +Y (no rot needed for a vertical climb). travel: eases @pos→target over `dur` s.
splat:rocket.ply  @-1.4,-2.5,0.2  *0.7   travel:-1.6,3.5,-0.6@drop,6.5     spin 0,0,-6   ^turbulence:0.2   beat:1.6  in @@drop     out @@bar:18
splat:rocket.ply  @1.5,-2.6,0.3   *0.65  travel:1.8,3.4,-0.7@bar:13,6      spin 0,0,7    beat:1.6  in @@bar:13   out @@bar:22
splat:rocket.ply  @1.4,-2.6,0.2   *0.7   travel:1.7,3.5,-0.7@climax,7      spin 0,0,8    ^turbulence:0.25  beat:1.8  in @@climax   out @@bar:34
splat:rocket.ply  @-1.5,-2.6,0.3  *0.65  travel:-1.8,3.4,-0.6@bar:31,7     spin 0,0,-7   beat:1.8  in @@bar:31   out @@outro

# UFOs — crossing the mid-background behind the hero: close enough to read as visible deep-space traffic,
# far enough never to overlap the centre.
splat:ufo.ply     @-3.2,1.6,3.2   *0.85  travel:3.2,1.3,3.2@bar:11,9     spin 0,40,0   beat:1.0  in @@bar:10   out @@bar:22
splat:ufo.ply     @3.4,1.7,3.4    *0.85  travel:-3.4,1.4,3.4@bar:30,9    spin 0,45,0   beat:1.0  in @@bar:30   out @@outro

# deFEEST MOTIF — a lone bitterbal drifts through the mid-void on a slow lissajous (small, distant).
mesh:bitterbal.glb @-2.4,-1.0,2.6  *0.2   path:liss:1.2,0.7,0.9,0.5,0.4,0.4  spin 0,30,0  alpha:0.65  ~fade  in @@drop  out @@bar:22
mesh:bitterbal.glb @2.4,-0.9,2.4   *0.18  travel:3.0,1.0,3.2   alpha:0.55  ~fade  in @@outro  out @@outro+7bar

# ── CAPTIONS (2D screen text overlay) ──────────────────────────────────────────
[caption]
# Credit roll: each line staggers in from below screen, scroll upward (center aligned)
screentext:martin engine · 2026   in @@outro+1bar  out @@outro+7bar  at 0,1.2  center  size 26  scroll 0.04  fade 0.5
screentext:opencode.ai           in @@outro+2bar  out @@outro+7bar  at 0,1.2  center  size 22  scroll 0.04  fade 0.5
screentext:Rust · Bevy · FunDSP  in @@outro+3bar  out @@outro+7bar  at 0,1.2  center  size 22  scroll 0.04  fade 0.5
screentext:Annex                 in @@outro+4bar  out @@outro+7bar  at 0,1.2  center  size 20  scroll 0.04  fade 0.5
screentext:BEDANKT               in @@outro+5bar  out @@outro+7bar  at 0,1.2  center  size 28  scroll 0.04  fade 1.0

# ── CAMERA TRACK ───────────────────────────────────────────────────────────────
# Framed WIDE so the void reads as deep 3D space: the hero morph sits centre with room around it, the
# rockets streak the edges, and the distant landmarks (saturn/moon) + UFOs give parallax depth. Cuts +
# yaw swings keep it vlot/explosive without diving so close the morph becomes abstract mush.
[camera]
# Intro: WIDE — the galaxy a small light in a vast void, slow push
t=@@bar:0     pos=0,0,0   dist=9    yaw=0.2    pitch=0.12
t=@@bar:2     pos=0,0,0   dist=7.5  yaw=0.5    pitch=0.10

# Build: push to medium, saturn looms far behind
t=@@bar:4     pos=0,0,0   dist=6.0  yaw=-0.2   pitch=0.18
t=@@bar:7     pos=0,0,0   dist=5.0  yaw=0.3    pitch=0.16

# Drop: medium framing with CUTS — hero centre, rockets streak the edges, void all around
t=@@bar:10    pos=0,0,0       dist=4.5  yaw=-0.2   pitch=0.14  cut
t=@@bar:12    pos=0.2,0.1,0   dist=5.0  yaw=0.6    pitch=0.20  cut
t=@@bar:14    pos=-0.2,0.1,0  dist=4.5  yaw=-0.7   pitch=0.12  cut
t=@@bar:16    pos=0.2,0,0     dist=5.2  yaw=0.4    pitch=0.22  cut
t=@@bar:18    pos=0,0,0       dist=4.0  yaw=-0.3   pitch=0.16  cut
t=@@bar:20    pos=0,0.1,0     dist=4.8  yaw=0.5    pitch=0.18  cut

# Breakdown: pull WIDE to the title in the void
t=@@bar:22    pos=0,0,0   dist=7    yaw=0      pitch=0.06   cut

# Climax: medium-wide parade, big swings; a PULL-BACK reveal of the deep field at the end
t=@@bar:26    pos=0,0.2,0     dist=4.2   yaw=0.3    pitch=0.12   cut
t=@@bar:28    pos=0.3,0.2,0   dist=5.0   yaw=-0.5   pitch=0.24   cut
t=@@bar:31    pos=-0.3,0.1,0  dist=4.5   yaw=0.7    pitch=0.16   cut
t=@@bar:34    pos=0.2,0.3,0   dist=5.2   yaw=-0.6   pitch=0.26   cut
t=@@bar:36    pos=0,0.2,0     dist=6.5   yaw=0.4    pitch=0.20   cut   # PULL BACK — hero + rockets + moon + UFO in the void

# Outro: wide drift out into deep space
t=@@bar:38    pos=0,0,0   dist=6    yaw=0.2    pitch=0.08   cut
t=@@bar:43    pos=0,0,0   dist=10   yaw=0.4    pitch=0.12

# ── SYNC TRACK (mood keyframes) ────────────────────────────────────────────────
[sync]
t=@@bar:0       flash=0.0   bg_dim=0.5   beat=0.9
t=@@bar:4       flash=0.2   bg_dim=0.42  beat=1.3
t=@@bar:10      flash=0.7   bg_dim=0.28  beat=2.0
t=@@bar:12      flash=0.6   bg_dim=0.22  beat=2.1
t=@@bar:14      flash=0.6   bg_dim=0.25  beat=2.0
t=@@bar:16      flash=0.6   bg_dim=0.22  beat=2.0
t=@@bar:18      flash=0.6   bg_dim=0.28  beat=1.9
t=@@bar:20      flash=0.9   bg_dim=0.25  beat=2.4
t=@@bar:22      flash=0.0   bg_dim=0.0   beat=0.4
t=@@bar:26      flash=0.7   bg_dim=0.22  beat=2.2
t=@@bar:28      flash=0.7   bg_dim=0.2   beat=2.2
t=@@bar:31      flash=0.7   bg_dim=0.22  beat=2.3
t=@@bar:34      flash=1.0   bg_dim=0.2   beat=2.4
t=@@bar:36      flash=0.6   bg_dim=0.25  beat=2.1
t=@@bar:38      flash=0.0   bg_dim=0.5   beat=1.0
t=@@bar:44      flash=0.0   bg_dim=0.7   beat=0.6
