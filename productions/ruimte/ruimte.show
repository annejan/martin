# RUIMTE — a maximalist cosmic morph journey through abstract shapes in space
# Music: productions/cities/score.txt (124 BPM, A-minor, epic night-drive synthwave)
# Section starts: intro 0 · build 7.7 · drop 19.4 · breakdown 42.6 · climax 50.3 · outro 73.5 (s)
#
# Shows off: all backdrop types, 6+ deforms, 5 entrance effects, caption center+scroll,
# per-object lissajous paths + travel, camera cuts, sync mood, tint modes, chroma post-FX,
# mesh + text + splat compose objects. Every engine toy.

[settings]
kind         = demo
pair         = match
score        = productions/cities/score.txt
ply          = assets/galaxy.ply
budget       = 150000
bg           = stars
post         = chroma
cam_pump     = 0.45              # bigger kick-lunge — the camera punches on every kick
flash        = 0.0
bg_dim       = 0.5
beat         = 1.0

# ── THE MORPH JOURNEY ──────────────────────────────────────────────────────────
# Each part is a shot in the sequence: one cloud morphs into the next.
#   @@anchor  @hold,morph[,bulge]  ~entrance  ^deform  backdrop:TYPE  tokens
[reel]
# ── INTRO (bars 0-3, 7.7s) ── Ontwaken: a galaxy IGNITES from black, camera already pushing
splat:galaxy.ply              @@intro    @4,1.5    ~fade                    backdrop:stars     rot:0,-0.12,0

# ── BUILD (bars 4-9, 11.6s) ── Vorming: snaps into a star, twisting hard
splat:star.ply                @@build    @4,2      ~morph   ^twist:0.6      backdrop:aurora   beat:1.4   rot:0,0.2,0   flash:0.3

# ── DROP (bars 10-21, 23.2s) ── EXPLOSIE: each shape BLASTS in and SLAMS on the kick (ease:snap),
# discrete bursts instead of slow flowing morphs — fast, punchy, a new shape every ~2 bars.
splat:helix.ply               @@bar:10   @1.5,0.9  ~shockwave  ease:snap  ^spiral:0.4     backdrop:rings    tint:brand    beat:1.7   flash:0.7
splat:knot.ply                @@bar:12   @1.5,0.8  ~explode    ease:snap  ^turbulence:0.6 backdrop:warp     tint:fry      beat:1.9   flash:0.6
splat:supershape.ply          @@bar:14   @1.5,0.9  ~shatter    ease:snap  ^wave:0.4       backdrop:kaleido  tint:rainbow  beat:1.8   flash:0.6
splat:mobius.ply              @@bar:16   @1.5,0.8  ~vortex     ease:snap  ^twist:0.5      backdrop:bolt     tint:brand    beat:1.8   flash:0.5
splat:sphere.ply              @@bar:18   @1,0.7    ~implode    ease:snap                  backdrop:bolt     tint:rainbow  beat:1.7   flash:0.6
splat:galaxy.ply              @@bar:20   @1.5,0.9  ~explode               ^turbulence:0.8 backdrop:stars                  flash:1.0  beat:2.3

# ── BREAKDOWN (bars 22-25, 7.7s) ── Stilte: black, the title SLAMS in (the one breather)
text:RUIMTE                   @@bar:22   @5,1      ~pen-write               backdrop:off       beat:0.6   rot:0,0,0

# ── CLIMAX (bars 26-37, 23.2s) ── GROOTS: a grand explosive parade (was ONE held galaxy = saai).
# Five shapes blast in on the kick across the finale — the energy keeps climbing, not coasting.
splat:galaxy.ply              @@climax   @2,1.2    ~shockwave  ease:snap  ^turbulence:0.8 backdrop:fractal  tint:brand    flash:0.9  beat:2.1
splat:supershape.ply          @@bar:28   @2,1      ~explode    ease:snap  ^wave:0.5       backdrop:kaleido  tint:rainbow  beat:2.1   flash:0.7
splat:knot.ply                @@bar:31   @2,1      ~shatter    ease:snap  ^turbulence:0.7 backdrop:warp     tint:fry      beat:2.2   flash:0.7
splat:star.ply                @@bar:34   @2,1      ~explode    ease:snap  ^twist:0.7      backdrop:rings    tint:brand    beat:2.3   flash:1.0
splat:galaxy.ply              @@bar:36   @1.5,1    ~vortex                ^turbulence:0.9 backdrop:fractal  tint:rainbow  beat:2.1

# ── OUTRO (bars 38-45, 15.5s) ── Vertrek: signature, credits scroll, fade
text:deFEEST                  @@outro    @10,2     ~pen-write               backdrop:stars     beat:1.0

# ── STAGE OBJECTS (parallel compose layer) ─────────────────────────────────────
[stage]
# Build: a single bitterbal on a lissajous orbit around the star, front-right
mesh:bitterbal.glb   @1.8,0.5,1.5   *0.35   path:liss:2.0,1.0,1.5,0.8,0.5,0.6   spin 0,30,0   alpha:0.7   ~fade   in @@build   out @@drop

# Drop: bitterballen swarm flies in with explode, orbits the morphs
mesh:bitterbal.glb   @-1.2,0.3,1.5   *0.25   path:liss:2.5,1.2,1.0,0.6,0.4,0.5   count:6   ~explode   tint:brand   beat:1.5   in @@drop   out @@bar:22

# Breakdown: a small, calm sphere floats upward in black
splat:sphere.ply     @0,-0.3,0     *0.4    drift 0,0.08,0   rot:0.1,0.2,0   alpha:0.4   ~fade   in @@bar:22   out @@climax

# Climax: torus travels across space with spiral deform, rainbow tint
splat:torus.ply      @-1.2,0.6,0.8   *0.5    travel:1.5,0.2,-0.5   ^spiral:0.4   rot:0.5,0.3,0.1   tint:rainbow   beat:1.8   in @@climax   out @@outro

# Climax: aegg logo subtly present, bottom-right
mesh:aegg.glb        @1.0,-0.5,0.5   *0.18   drift -0.02,0,0     alpha:0.5   ~fade   in @@climax   out @@outro

# Outro: bitterbal drifts by as credits appear
mesh:bitterbal.glb   @-2,0,0.5       *0.2    travel:2.5,-0.3,-0.5   path:liss:1.0,0.5,0.3,0.3,0.2,0.2   alpha:0.4   ~fade   in @@outro   out @@outro+7bar

# ── SPACE OBJECTS + ACTION ─────────────────────────────────────────────────────
# Procedural splatgen props (rocket/saturn/ufo/moon). rocket nose points +Y, so a +Y travel target =
# a launch; tilt the nose along an arc with `rot 0,0,deg`. travel: eases @pos→target over `dur` s
# (default one bar) then HOLDS at the target — perfect for a blast-off / a saucer streaking past.
# Build: a ringed SATURN hangs back-right — establishes the cosmos early (this is space).
splat:saturn.ply  @1.7,0.8,2.3    *0.9   rot 0,0,0   spin 0,4,0   alpha:0.9   ~fade   in @@build   out @@bar:22
# Drop: a HERO rocket blasts off straight up through the morph parade, exhaust blazing.
splat:rocket.ply  @0.3,-1.4,0.4   *0.8   travel:0.6,3.4,-0.5@drop,7      spin 0,0,6    ^turbulence:0.25  beat:1.7  in @@drop    out @@bar:18
# Drop: a second rocket streaks up the far side, tilted along its arc.
splat:rocket.ply  @-1.7,-1.2,0.9  *0.5   rot 0,0,26   travel:1.5,3.0,-0.4@bar:13,6   spin 0,0,-10  beat:1.6  in @@bar:13   out @@bar:22
# Drop: a UFO zips across the parade, spinning — a fun cameo (left → right).
splat:ufo.ply     @-2.3,0.6,1.0   *0.45  travel:2.5,0.2,0.8@bar:11,7     spin 0,45,0   beat:1.4  in @@bar:10   out @@bar:18
# Climax: a MOON hangs in the deep void — a second body, gives the cosmos scale.
splat:moon.ply    @-1.7,1.0,1.9   *0.7   spin 0,5,0   alpha:0.85   ~fade   in @@climax   out @@outro
# Climax: rockets streak across the grand finale, beat-reactive, deforming as they tear past.
splat:rocket.ply  @1.9,-1.3,0.6   *0.55  rot 0,0,-22  travel:-1.0,3.2,-0.5@climax,8  spin 0,0,9   ^turbulence:0.3  beat:1.9  in @@climax  out @@outro
splat:rocket.ply  @-1.3,-1.5,1.0  *0.45  travel:0.8,3.6,-0.6@bar:30,7    spin 5,0,5    beat:1.8  in @@bar:30   out @@outro
# Climax: a UFO swoops the other way across the finale, spinning fast.
splat:ufo.ply     @2.3,0.9,1.2    *0.4   travel:-2.6,-0.2,0.7@bar:31,8   spin 0,55,0   beat:1.6  in @@bar:31   out @@outro

# ── CAPTIONS (2D screen text overlay) ──────────────────────────────────────────
[caption]
# Credit roll: each line staggers in from below screen, scroll upward (center aligned)
screentext:martin engine · 2026   in @@outro+1bar  out @@outro+7bar  at 0,1.2  center  size 26  scroll 0.04  fade 0.5
screentext:opencode.ai           in @@outro+2bar  out @@outro+7bar  at 0,1.2  center  size 22  scroll 0.04  fade 0.5
screentext:Rust · Bevy · FunDSP  in @@outro+3bar  out @@outro+7bar  at 0,1.2  center  size 22  scroll 0.04  fade 0.5
screentext:Annex                 in @@outro+4bar  out @@outro+7bar  at 0,1.2  center  size 20  scroll 0.04  fade 0.5
screentext:BEDANKT               in @@outro+5bar  out @@outro+7bar  at 0,1.2  center  size 28  scroll 0.04  fade 1.0

# ── CAMERA TRACK ───────────────────────────────────────────────────────────────
[camera]
# Intro: galaxy fills the view, a FAST push begins (no slow drift)
t=@@bar:0     pos=0,0,0   dist=7    yaw=0.2    pitch=0.12
t=@@bar:2     pos=0,0,0   dist=5.5  yaw=0.5    pitch=0.08

# Build: push in hard, arc as the star twists
t=@@bar:4     pos=0,0,0   dist=4.5  yaw=-0.3   pitch=0.22
t=@@bar:7     pos=0,0,0   dist=3.5  yaw=0.2    pitch=0.18

# Drop: HARD CUT on every shape — fast whip-orbit through the blasting parade
t=@@bar:10    pos=0,0,0       dist=2.6  yaw=-0.2   pitch=0.12  cut
t=@@bar:12    pos=0.3,0.1,0   dist=3.2  yaw=0.6    pitch=0.18  cut
t=@@bar:14    pos=-0.3,0.1,0  dist=2.8  yaw=-0.7   pitch=0.10  cut
t=@@bar:16    pos=0.2,-0.1,0  dist=3.4  yaw=0.4    pitch=0.22  cut
t=@@bar:18    pos=0,0,0       dist=2.3  yaw=-0.3   pitch=0.14  cut
t=@@bar:20    pos=0,0.1,0     dist=2.8  yaw=0.5    pitch=0.16  cut

# Breakdown: pull back to wide, centered on the title
t=@@bar:22    pos=0,0,0   dist=6    yaw=0      pitch=0.05   cut

# Climax: DIVE in, hard cut on each new shape, big yaw swings
t=@@bar:26    pos=0,0.2,0     dist=2.3   yaw=0.3    pitch=0.10   cut
t=@@bar:28    pos=0.4,0.2,0   dist=3.0   yaw=-0.5   pitch=0.24   cut
t=@@bar:31    pos=-0.4,0.1,0  dist=2.6   yaw=0.7    pitch=0.14   cut
t=@@bar:34    pos=0.2,0.3,0   dist=3.2   yaw=-0.6   pitch=0.28   cut
t=@@bar:36    pos=0,0,0       dist=2.4   yaw=0.4    pitch=0.16   cut

# Outro: pull back to the signature, drift out
t=@@bar:38    pos=0,0,0   dist=4.5  yaw=0.2    pitch=0.06   cut
t=@@bar:43    pos=0,0,0   dist=8    yaw=0.4    pitch=0.10

# ── SYNC TRACK (mood keyframes) ────────────────────────────────────────────────
[sync]
t=@@bar:0       flash=0.0   bg_dim=0.5   beat=0.9
t=@@bar:4       flash=0.2   bg_dim=0.42  beat=1.3
t=@@bar:10      flash=0.7   bg_dim=0.28  beat=2.0
t=@@bar:12      flash=0.6   bg_dim=0.22  beat=2.1
t=@@bar:14      flash=0.6   bg_dim=0.25  beat=2.0
t=@@bar:16      flash=0.6   bg_dim=0.22  beat=2.0
t=@@bar:18      flash=0.6   bg_dim=0.28  beat=1.9
t=@@bar:20      flash=0.9   bg_dim=0.25  beat=2.4
t=@@bar:22      flash=0.0   bg_dim=0.0   beat=0.4
t=@@bar:26      flash=0.7   bg_dim=0.22  beat=2.2
t=@@bar:28      flash=0.7   bg_dim=0.2   beat=2.2
t=@@bar:31      flash=0.7   bg_dim=0.22  beat=2.3
t=@@bar:34      flash=1.0   bg_dim=0.2   beat=2.4
t=@@bar:36      flash=0.6   bg_dim=0.25  beat=2.1
t=@@bar:38      flash=0.0   bg_dim=0.5   beat=1.0
t=@@bar:44      flash=0.0   bg_dim=0.7   beat=0.6
