# martin — CITIES · deFEEST: the shareable loop (rev. 4 — the CAUSAL loop). The snack you follow IS the
# brand: a deep-fried bitterbal drifts through the city tour, then at the end the whole skyline balls up
# into a giant bitterbal which morphs into the deFEEST logo — which (loop) dissolves back into the city.
# Forever. TWO LAYERS:
#   LAYER 1 [reel]  — deFEEST logo → low pair=match city tour → Seattle BALLS into a fried bitterbal →
#                     the bitterbal morphs into the deFEEST logo → wrap to the intro (seamless seam).
#   LAYER 2 [stage] — the deFEEST wordmark HANDWRITES in over the skyline + a small drifting bitterbal
#                     (the motif) + the ©Google credit.
#
#   live loop:  MARTIN_LOOP=1 MARTIN_SHOW=productions/cities/cities-defeest.show cargo +nightly run --release
#   record:     MARTIN_SHOW=productions/cities/cities-defeest.show ./record.sh cities-defeest.mp4
#
# LOCAL captures only (Google Maps Content — ©Google credit on screen). defeest.glb / bitterbal.glb /
# the four *_tight.ply symlink into austin_run/exports/. ~89s, loops (logo→logo seam, through black).

[settings]
kind = demo
pair = match
budget = 1200000              # crisp (override MARTIN_MORPH_COUNT=250000/500000 for previews)
ply = austin_run/exports/austin_tight.ply
score = productions/cities/score.txt   # moody A-minor synthwave night-drive (this production's own track)
flash = 0.25
bg_dim = 0.4
pw_step = 0.35
pw_splat = 0.004

# LAYER 1 — logo → city tour (per-city sky/weather/pulse) → Seattle balls into a bitterbal → the logo.
[reel]
glb:defeest.glb           @@intro      @5,5    beat:0   backdrop:stars                            # deFEEST mesh ⇄ blobs → city
splat:austin_tight.ply    @@drop       @6,7,0  ~morph  beat:0.8                 backdrop:stars      # AUSTIN — night, calm
splat:nyc_tight.ply                    @6,7,0  ~morph  beat:1.4  flash:0.5  ^turbulence:0.2  raster:position  backdrop:stars  # NEW YORK — RAINBOW shader city (the vet drop), churn, punch
splat:chicago_tight.ply   @@breakdown  @6,7,0  ~morph  beat:1.0  ^wind:0.25     backdrop:grid       # CHICAGO — the grid + wind
splat:seattle_tight.ply   @@climax     @16,7,0 ~morph  beat:1.6  flash:0.5  ^ripple:0.15  backdrop:rings   # SEATTLE — water, climax, holds
mesh:bitterbal.glb        @@outro      @2,6,0  ~morph  tint:fry  beat:1.0       backdrop:stars      # the SKYLINE balls up into a giant DEEP-FRIED BITTERBAL
mesh:defeest.glb          rot:180,0,0  @3,5    ~morph  beat:0                   backdrop:stars      # bitterbal → the deFEEST logo (splats, rot cancels the base flip-X) → wrap to the intro (CAUSAL LOOP)

# LAYER 2 — wordmark handwrites over the cities; a small bitterbal drifts through earlier (the motif);
# the credit shows during Seattle. All gone before the bitterbal/logo finale so it reads clean.
[stage]
text:deFEEST          @0,0.26,0    *0.42  ~pen-write  tint:brand                in breakdown  out outro   # wordmark handwrites in, blue→gold
mesh:bitterbal.glb    @0.22,0.08,0.12 *0.08  spin 17,43,11  bob 0.03  ^turbulence:0.3  drift 0.013,0,-0.009  ~morph  tint:fry  in drop  out breakdown  # the snack motif — coprime spin/bob → organic, never-repeating tumble
text:Imagery ©Google  @0,-0.4,0    *0.5   ~fade  tint:brand                    in climax  out outro       # credit during Seattle, brand gold

# camera: high raked establishing on the logo → dive → city tour (frontal through the write) → the DOME
# on the climax → PULL BACK to frame the skyline balling into the bitterbal → and the logo forming at
# the intro pose, so the loop seam (logo → logo, through black) is invisible.
[camera]
t=@@intro      pos=0,0.35,0     dist=1.9   yaw=1.32  pitch=0.50   # logo: high + raked, establishing
t=15.0         pos=0,0.12,0     dist=1.4   yaw=1.40  pitch=0.32   # descend, yaw settles to front
t=@@drop       pos=0,0.12,0     dist=1.2   yaw=1.44  pitch=0.26   # logo→AUSTIN morph at mid-height
t=27.0         pos=-0.1,0.05,0  dist=0.9   yaw=1.46  pitch=0.16   # descend low into the formed city
t=32.0         pos=0.10,0.04,0  dist=0.78  yaw=1.48  pitch=0.14   # low pass THROUGH the towers
t=@@breakdown  pos=0,0.12,0     dist=0.95  yaw=1.50  pitch=0.15   # HOLD head-on — the wordmark handwrites
t=49.0         pos=0,0.12,0     dist=0.94  yaw=1.50  pitch=0.15   # hold so the write breathes
t=@@climax     pos=0,0.14,0     dist=0.95  yaw=1.43  pitch=0.22   # SEATTLE — the curved-earth DOME hero shot
t=66.0         pos=0,0.18,0     dist=1.2   yaw=1.45  pitch=0.28   # rise out of the dome
t=@@outro      pos=0,0.22,0     dist=1.55  yaw=1.45  pitch=0.36   # pull back to frame the skyline balling up
t=82.0         pos=0,0.30,0     dist=1.82  yaw=1.45  pitch=0.46   # the bitterbal becomes the logo…
t=88.5         pos=0,0.35,0     dist=1.9   yaw=1.45  pitch=0.50   # …at the intro pose → seamless loop

# [sync] — the music-timed LOOK track (Stage 4 SyncTrack): keyframe the global knobs over the score so
# the look breathes with the music. Bloom swells into the drop + climax; the backdrop dims for the
# climax drama and lifts in the breakdown; beat-reactivity ramps to the climax. (Per-Shot flash:/beat:
# still layer on top of these as the per-shot accents.)
[sync]
t=@@intro      flash=0.15  bg_dim=0.5   beat=0.5    # calm open
t=@@drop       flash=0.55  bg_dim=0.35  beat=1.3    # bloom + energy lift into the drop
t=@@breakdown  flash=0.1   bg_dim=0.55  beat=0.6    # pull back, backdrop lifts, hushed
t=@@climax     flash=0.7   bg_dim=0.2   beat=1.7    # peak: bright bloom, dim backdrop, full beat
t=@@outro      flash=0.25  bg_dim=0.45  beat=0.8    # ease down toward the loop
