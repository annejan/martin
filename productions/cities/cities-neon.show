# martin — CITIES · NEON: the rainbow-city reveal. The real aerial captures (austin/nyc/seattle)
# render `raster:position` — the fork's debug-shading colour-by-XYZ mode, a rainbow gradient across
# the whole skyline — the same technique as the "NEW YORK — RAINBOW shader city" kill-shot in
# cities-defeest, but here it's the WHOLE hold, not a flash. Straight pair=match morph carries one
# rainbow city into the next. On an ORIGINAL Halcyon-esque dreamy ambient-techno loop (own composition,
# no copyright — score-neon.txt). LOCAL captures only (Google Maps Content, not shippable — see
# pipeline/AERIAL-CITIES.md).
#
#   MARTIN_SHOW=productions/cities/cities-neon.show MARTIN_RES=480x270 MARTIN_PREVIEW_FPS=8 \
#     MARTIN_MORPH_COUNT=250000 ./record.sh cities-neon.mp4
#
# bpm 128, bar=1.875s, 96 bars (~180s). Austin(0-28)→NYC(28-56)→Seattle(56-76)→outro(76-96).

[settings]
kind = demo
pair = match
budget = 1200000
ply = austin_run/exports/austin_tight.ply
score = productions/cities/score-neon.txt
beat = 0.18
flash = 0.4                    # a bloom kiss on each city-to-city morph

[reel]
# --- the reveal: raster:position colours every splat by its XYZ → a rainbow gradient across the whole
#     skyline, for the whole hold (not just an entrance flash). Straight pair=match morph between. ---
splat:austin_tight.ply         @@bar:0    @28,3.5,0  ~morph   raster:position  backdrop:stars   # AUSTIN, rainbow
splat:nyc_tight.ply            @@bar:28   @28,2.5,0  ~morph   raster:position  backdrop:stars   # NYC, rainbow
splat:seattle_tight.ply        @@bar:56   @20,2.5,0  ~morph   raster:position  backdrop:stars   # SEATTLE, rainbow
text:deFEEST · NEON CITIES     @@bar:76   @6,4       ~pen-write ^wave exit:evaporate backdrop:off # crisp signature (normal colour)

# --- the camera: the proven WIDE GRAZING DRONE language (dist 0.86-1.15, pitch 0.39-0.46, continuous
#     bank/orbit, never top-down) — longer holds now (no bursts to cut away to), so more waypoints per
#     city keep it relentless the whole way through. ---
[camera]
# --- AUSTIN (bar 0-28) ---
t=@@bar:0    pos=0,0.08,0       dist=1.05  yaw=1.10   pitch=0.42   # establish: wide grazing rainbow skyline
t=@@bar:6    pos=-0.10,0.07,0.06 dist=0.92 yaw=0.55   pitch=0.40   # bank left, downtown sweeps across
t=@@bar:12   pos=0.10,0.07,-0.05 dist=0.95 yaw=1.95   pitch=0.42   # orbit right, grazing the towers
t=@@bar:18   pos=-0.06,0.09,0.05 dist=0.90 yaw=1.20   pitch=0.40   # bank back across the cluster
t=@@bar:23   pos=0,0.10,0       dist=1.15  yaw=1.60   pitch=0.46   # pull wide → into the NYC morph
# --- NYC (bar 28-56) ---
t=@@bar:28   pos=0,0.07,0       dist=0.90  yaw=1.15   pitch=0.34   # NYC slams in, wide grazing bank
t=@@bar:34   pos=-0.11,0.06,0.06 dist=0.86 yaw=0.50   pitch=0.32   # bank low-and-across Manhattan
t=@@bar:40   pos=0.11,0.06,-0.05 dist=0.88 yaw=1.95   pitch=0.34   # orbit the skyline the other way
t=@@bar:46   pos=-0.05,0.08,0.05 dist=0.88 yaw=1.30   pitch=0.36   # bank back, rainbow raking past
t=@@bar:51   pos=-0.04,0.09,0.04 dist=1.05 yaw=1.70   pitch=0.42   # pull wide → into the Seattle morph
# --- SEATTLE (bar 56-76) ---
t=@@bar:56   pos=0,0.07,0       dist=0.92  yaw=1.15   pitch=0.40   # Seattle slams in, grazing bank
t=@@bar:62   pos=-0.11,0.06,0.06 dist=0.86 yaw=0.50   pitch=0.39   # bank across downtown, towers rake
t=@@bar:68   pos=0.11,0.06,-0.05 dist=0.88 yaw=2.00   pitch=0.40   # orbit the skyline
t=@@bar:72   pos=0.04,0.10,0.0  dist=1.10  yaw=1.50   pitch=0.45   # big wide bank → into the outro
# --- OUTRO (bar 76-96) ---
t=@@bar:76   pos=0,0,0          dist=1.4   yaw=1.42   pitch=0.32   # wide + level for the crisp signature
t=@@bar:96   pos=0,0,0          dist=2.2   yaw=1.45   pitch=0.28   # final glide out as it evaporates
