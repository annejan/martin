# martin — CITIES · NEON: the neon-city-fly. Real aerial captures (normal alpha-over, wide-grazing
# drone) ALTERNATE with glowing procedural energy-bursts (MARTIN_ADDITIVE, per-shot `additive:1`) as
# the city-to-city transitions — a genuine combination of BOTH render modes in one flow. Additive barely
# changes a real capture (thin near-opaque surface, little overlap — A/B tested), so it's saved for the
# BURST content (dense volumetric procedural shapes) where it actually glows; the cities stay crisp
# alpha-over. On an ORIGINAL Halcyon-esque dreamy ambient-techno loop (own composition, no copyright —
# score-neon.txt). LOCAL captures only (Google Maps Content, not shippable — pipeline/AERIAL-CITIES.md).
#
#   MARTIN_SHOW=productions/cities/cities-neon.show MARTIN_RES=480x270 MARTIN_PREVIEW_FPS=8 \
#     MARTIN_MORPH_COUNT=250000 ./record.sh cities-neon.mp4
#
# bpm 128, bar=1.875s, 96 bars (~180s): intro(0-4) groove1(4-28) groove2(28-52) break(52-56)
# lift(56-76) outro(76-96). Austin(0-20)→BURST(20-28)→NYC(28-46)→BURST(46-52)→
# Seattle(52-68)→BURST(68-76)→outro(76-96).

[settings]
kind = demo
pair = match
budget = 1200000
ply = austin_run/exports/austin_tight.ply
score = productions/cities/score-neon.txt
beat = 0.18
flash = 0.5                    # a bloom kiss on every transition (city↔burst, both ways)

[reel]
# --- CITIES: normal alpha-over (additive:0 explicit — never inherit a global override by accident). ---
splat:austin_tight.ply         @@bar:0    @20,3.5,0  ~morph   additive:0  backdrop:stars   # AUSTIN, crisp
splat:galaxy.ply                @@bar:20   @8,2.4,1.4 ~explode ^turbulence additive:1  backdrop:off     # BURST 1: nebula ignites
splat:nyc_tight.ply            @@bar:28   @18,2.5,0  ~morph   additive:0  backdrop:stars   # NYC, crisp
splat:helix.ply                 @@bar:46   @6,1.3,1.6 ~vortex ^spiral    additive:1  backdrop:off     # BURST 2: neon DNA-tube
splat:seattle_tight.ply        @@bar:52   @16,2.5,0  ~morph   additive:0  backdrop:stars   # SEATTLE, crisp
splat:supershape.ply            @@bar:68   @8,1.4,1.6 ~morph  ^turbulence additive:1  backdrop:off     # BURST 3: rainbow glow-bloom
text:deFEEST · NEON CITIES     @@bar:76   @6,4       ~pen-write ^wave additive:0 exit:evaporate backdrop:off # crisp signature

# --- the camera: WIDE GRAZING DRONE on the cities (the proven cities-energy language — dist 0.86-1.15,
#     pitch 0.39-0.46, continuous bank/orbit, never top-down); a tight PUSH-IN on the bursts (dist
#     ~2.0-2.6, matching the nebula-show framing) so the glow fills the frame. Never settles. ---
[camera]
# --- AUSTIN (wide grazing drone, bar 0-20) ---
t=@@bar:0    pos=0,0.08,0       dist=1.05  yaw=1.10   pitch=0.42   # establish: wide grazing skyline
t=@@bar:5    pos=-0.10,0.07,0.06 dist=0.92 yaw=0.55   pitch=0.40   # bank left, downtown sweeps across
t=@@bar:10   pos=0.10,0.07,-0.05 dist=0.95 yaw=1.95   pitch=0.42   # orbit right, grazing the towers
t=@@bar:15   pos=0,0.10,0       dist=1.15  yaw=1.30   pitch=0.46   # pull wide → into the burst
# --- BURST 1 (galaxy ignites, push in close, bar 20-28) ---
t=@@bar:20   pos=0,0,0          dist=2.2   yaw=1.20   pitch=0.30   # the nebula explodes together, close
t=@@bar:24   pos=0,0,0          dist=2.0   yaw=1.90   pitch=0.35   # orbit the glow
# --- NYC (wide grazing drone, bar 28-46) ---
t=@@bar:28   pos=0,0.07,0       dist=0.90  yaw=1.15   pitch=0.34   # NYC slams in, wide grazing bank
t=@@bar:33   pos=-0.11,0.06,0.06 dist=0.86 yaw=0.50   pitch=0.32   # bank low-and-across Manhattan
t=@@bar:38   pos=0.11,0.06,-0.05 dist=0.88 yaw=1.95   pitch=0.34   # orbit the skyline the other way
t=@@bar:43   pos=-0.04,0.09,0.04 dist=1.05 yaw=1.40   pitch=0.42   # pull wide → into the burst
# --- BURST 2 (helix, tighter orbit — the neon tube reads best close, bar 46-52) ---
t=@@bar:46   pos=0,0,0          dist=2.5   yaw=1.10   pitch=0.15   # the DNA-tube spins up out of the vortex
t=@@bar:49   pos=0,0,0          dist=2.3   yaw=2.00   pitch=0.22   # arc around it
# --- SEATTLE (wide grazing drone, bar 52-68) ---
t=@@bar:52   pos=0,0.07,0       dist=0.92  yaw=1.15   pitch=0.40   # Seattle slams in, grazing bank
t=@@bar:58   pos=-0.11,0.06,0.06 dist=0.86 yaw=0.50   pitch=0.39   # bank across downtown, towers rake
t=@@bar:63   pos=0.11,0.06,-0.05 dist=0.88 yaw=2.00   pitch=0.40   # orbit the skyline
t=@@bar:67   pos=0.04,0.10,0.0  dist=1.10  yaw=1.50   pitch=0.45   # big wide bank → into the final burst
# --- BURST 3 (supershape, the closing glow-bloom, bar 68-76) ---
t=@@bar:68   pos=0,0,0          dist=2.6   yaw=1.30   pitch=0.25   # the rainbow bloom opens
t=@@bar:72   pos=0,0,0          dist=2.4   yaw=1.90   pitch=0.30   # orbit as it settles
# --- OUTRO (bar 76-96) ---
t=@@bar:76   pos=0,0,0          dist=1.4   yaw=1.42   pitch=0.32   # wide + level for the crisp signature
t=@@bar:96   pos=0,0,0          dist=2.2   yaw=1.45   pitch=0.28   # final glide out as it evaporates
