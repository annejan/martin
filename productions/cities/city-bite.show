# martin — CITY BITE 🟤🌃: the world is a bitterbal, and tonight it's raining on Austin. ONE city
# skyline (austin_tight) sits LOW and far back as the only big splat cloud; a swarm of deep-fried
# bitterballen tumbles down in front of it, each on its OWN coprime path (never repeats), z-safe
# because they're meshes. The deFEEST wordmark drifts in, and on the drop a hero bitterbal SLAMS the
# frame (kill-shot). 100% local assets.
#
#   live:    MARTIN_LOOP=1 MARTIN_SHOW=productions/cities/city-bite.show cargo +nightly run --release
#   preview: TMPDIR=~/.cache/martin-render MARTIN_MUTE=1 MARTIN_RES=480x270 MARTIN_PREVIEW_FPS=8 \
#            MARTIN_SHOW=productions/cities/city-bite.show ./record.sh /tmp/city-bite.mp4

[settings]
kind     = demo
score    = productions/cities/score.txt   # epic A-minor synthwave (intro/build/drop/breakdown/climax/outro)
ply      = assets/sphere.ply              # .ply root = assets/  → splat:austin_tight.ply resolves here
budget   = 220000                          # caps splats PER object; the city is the only heavy one
bg       = stars                           # night sky above the skyline
post     = chroma                          # RGB-split shears on the kick
cam_pump = 0.3
flash    = 0.25
bg_dim   = 0.5

# ONE big splat backdrop ONLY (the skyline), pushed LOW and FAR back behind everything (z=-7), tiny
# vertical offset so the horizon sits low (rule of thirds). Everything else is mesh: → z-buffered →
# safe to live in FRONT of the city's centre depth without vanishing.
[stage]
# ---- THE CITY · low backdrop, far back, breathing on the kick (camera moves, the city is stable) ----
splat:austin_tight.ply  @0,-1.4,-7   *2.4   sway 0,8,0   bob 0.05   in intro   count:16000

# ---- THE RAIN · a dense downpour of bitterballen, EACH its OWN coprime lissajous weave + gentle fall
#      + own spin + own entry bar → no two ever sync, every bal doet wat ie wil. All in FRONT of the
#      city (positive z, near camera). The weave dominates (the bal lingers + swirls), the slow -y drift
#      makes it descend; staggered entries (bars 2..13) overlap into a continuous, living downpour.
mesh:bitterbal.glb  @-3.2,1.60,1.30  *0.150  spin 11,13,9  drift 0,-0.090,0  path:liss:1.00,0.50,0.80,3,2,5,0.110  tint:fry  ~morph  in bar:3   count:2500
mesh:bitterbal.glb  @-2.2,2.00,1.75  *0.170  spin 18,24,14  drift 0,-0.110,0  path:liss:1.35,0.80,1.05,2,5,3,0.128  tint:fry  ~morph  in bar:4   count:2800
mesh:bitterbal.glb  @-1.2,2.40,2.20  *0.190  spin 25,35,19  drift 0,-0.130,0  path:liss:1.70,1.10,1.30,5,3,2,0.146  tint:fry  ~morph  in bar:5   count:3000
mesh:bitterbal.glb  @-0.3,2.80,2.65  *0.210  spin 32,46,24  drift 0,-0.150,0  path:liss:2.05,0.50,1.55,3,5,7,0.164  tint:fry  ~morph  in bar:6   count:3300
mesh:bitterbal.glb  @0.6,3.20,1.30  *0.230  spin 39,13,29  drift 0,-0.170,0  path:liss:1.00,0.80,0.80,7,2,3,0.182  tint:fry  ~morph  in bar:7   count:3500
mesh:bitterbal.glb  @1.5,1.60,1.75  *0.150  spin 46,24,34  drift 0,-0.190,0  path:liss:1.35,1.10,1.05,2,7,5,0.200  tint:fry  ~morph  in bar:8   count:2500
mesh:bitterbal.glb  @2.4,2.00,2.20  *0.170  spin 13,35,39  drift 0,-0.090,0  path:liss:1.70,0.50,1.30,5,7,2,0.110  tint:fry  ~morph  in bar:9   count:2800
mesh:bitterbal.glb  @3.2,2.40,2.65  *0.190  spin 20,46,44  drift 0,-0.110,0  path:liss:2.05,0.80,1.55,3,7,5,0.128  tint:fry  ~morph  in bar:10   count:3000
mesh:bitterbal.glb  @-2.6,2.80,1.30  *0.210  spin 27,13,11  drift 0,-0.130,0  path:liss:1.00,1.10,0.80,7,3,2,0.146  tint:fry  ~morph  in bar:4   count:3300
mesh:bitterbal.glb  @-0.8,3.20,1.75  *0.230  spin 34,24,16  drift 0,-0.150,0  path:liss:1.35,0.50,1.05,2,3,7,0.164  tint:fry  ~morph  in bar:6   count:3500
mesh:bitterbal.glb  @1.0,1.60,2.20  *0.150  spin 41,35,21  drift 0,-0.170,0  path:liss:1.70,0.80,1.30,5,2,7,0.182  tint:fry  ~morph  in bar:8   count:2500
mesh:bitterbal.glb  @2.0,2.00,2.65  *0.170  spin 48,46,26  drift 0,-0.190,0  path:liss:2.05,1.10,1.55,7,5,3,0.200  tint:fry  ~morph  in bar:10   count:2800

# ---- THE BRAND · wordmark drifts in upper-left (rule of thirds), in front of the city ----
text:deFEEST  @-1.6,1.4,2.2  *0.9  bob 0.1  tint:brand  ~pen-write  in build  out climax

# ---- THE KILL-SHOT · on the drop, a HERO bitterbal swings up front (fried) — sized so it punches the
#      frame without becoming a wall of brown (z2.2 *0.7, camera dist ~3.2 → fills ~⅔, city still reads)
mesh:bitterbal.glb  @1.5,0.2,0.5  *0.42  spin 0,26,0  tint:fry  ~shockwave  flash:0.95  beat:1.8  in drop  out breakdown   count:16000

# ---- THE PUNCHLINE · returns through climax over the snack-storm ----
text:de wereld is een bitterbal  @1.3,1.6,2.4  *0.85  bob 0.08  tint:brand  ~pen-write  in climax

# ---- THE LOGO · the brand mark lands the outro ----
mesh:defeest.glb  @0,0.6,2.6  *1.1  rot 180,0,0  bob 0.10  sway 0,6,0  ~morph  in outro   count:12000   # mesh: = sampled gaussians, renders reliably in [stage] (glb:/GlMesh is reel-only)

# Camera: establish the LOW skyline (horizon bottom third, sky full of falling snacks) → push in as the
# rain builds → SLAM to a tight kill-shot on the drop (cut) → switch sides, orbit the storm → settle
# front-on the logo. Low pitch throughout; the city stays a backdrop, never centred.
[camera]
t=@@intro      pos=-1.2,0.3,-2   dist=6.2   yaw=1.30   pitch=0.10   # wide: skyline low-left, night sky open
t=@@build      pos= 0.6,0.6,0    dist=5.4   yaw=1.45   pitch=0.06   # push toward the falling snacks
t=@@drop       pos= 0.0,0.4,2    dist=3.2   yaw=1.42   pitch=0.04   cut   # SLAM onto the hero bitterbal (kill-shot)
t=@@breakdown  pos=-1.5,0.5,-1   dist=5.8   yaw=1.95   pitch=0.12   # switch sides: city right third, calm
t=@@climax     pos= 1.1,0.4,0    dist=5.2   yaw=1.55   pitch=0.16   # orbit the snack-storm, grand
t=@@outro      pos= 0.0,0.5,1    dist=6.0   yaw=1.45   pitch=0.20   # settle front-on the logo + loop

[sync]
t=@@intro      flash=0.10  bg_dim=0.45  beat=0.3   bg=stars     # night-city calm
t=@@build      flash=0.22  bg_dim=0.5   beat=1.0                # the rain begins — energy rising
t=@@drop       flash=0.95  bg_dim=0.35  beat=1.8                # THE BITE — full kick, bloom, chroma shear
t=@@breakdown  flash=0.2   bg_dim=0.55  beat=0.7   bg=stars     # hush, snacks drifting
t=@@climax     flash=0.7   bg_dim=0.35  beat=1.9                # peak — the storm + the punchline
t=@@outro      flash=0.25  bg_dim=0.5   beat=0.7                # ease to the logo + loop
