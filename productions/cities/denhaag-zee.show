# martin — DEN HAAG → ZEE (snake-route flyover): the camera flies a WINDING path — Centraal
# Station → Binnenhof/Hofvijver → snaking through the Zeeheldenkwartier → the dunes → Scheveningen,
# where the strip simply ENDS: water returns no lidar, so the city dissolves into black sea.
# Route + corridor + this [camera] track are GENERATED by pipeline/nl_city_splat.py:
#   pipeline/nl_city_splat.py denhaag-zee --count 1800000 --emit-camera --duration 80
# (7 subtiles under the corridor, 141.8M points → 1.8M splats.) Data: AHN CC0 · GeoTiles CC-BY.

[settings]
kind = demo
# `ply =` doubles as the asset root the [reel] splat: names resolve against — never omit it.
ply = austin_run/exports/denhaag_zee_tight.ply
budget = 1800000
score = productions/cities/score.txt
flash = 0.25
bg_dim = 0.45

[reel]
splat:denhaag_zee_tight.ply  @70,10,0  ~morph  beat:0.9  backdrop:stars

# generated flight track (yaw = path heading; first key re-aimed high at the city as an
# establishing shot, last key pulls up over the sea).
[camera]
t=0.0  pos=0.73,0.05,0.77   dist=1.8   yaw=0.06  pitch=0.55
t=12.5  pos=0.31,0.05,0.74   dist=0.45  yaw=1.04  pitch=0.15
t=22.7  pos=0.14,0.05,0.45   dist=0.45  yaw=-0.23 pitch=0.15
t=32.5  pos=-0.19,0.05,0.52  dist=0.45  yaw=1.35  pitch=0.15
t=46.0  pos=-0.29,0.05,0.07  dist=0.45  yaw=0.50  pitch=0.15
t=55.2  pos=-0.56,0.05,-0.07 dist=0.45  yaw=1.87  pitch=0.15
t=67.5  pos=-0.43,0.05,-0.47 dist=0.45  yaw=0.78  pitch=0.15
t=80.0  pos=-0.73,0.10,-0.77 dist=0.9   yaw=0.78  pitch=0.30
t=88.5  pos=-0.85,0.25,-0.85 dist=2.4   yaw=0.70  pitch=0.55

[sync]
t=@@intro      flash=0.3   bg_dim=0.5   beat=0.9
t=@@drop       flash=0.5   bg_dim=0.35  beat=1.2
t=@@climax     flash=0.6   bg_dim=0.25  beat=1.5
t=@@outro      flash=0.2   bg_dim=0.5   beat=0.7
