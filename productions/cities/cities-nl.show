# martin — CITIES · deFEEST · NL edition (the SHIPPABLE one — Evoke candidate). Same causal loop as
# cities-defeest.show, but the four skylines are DUTCH cities built from open data, so this version
# may be bundled, uploaded, and shown anywhere (unlike the Google-derived captures, which stay local):
#   GRONINGEN (home turf — Martinitoren) → ROTTERDAM (the skyline — the kill-shot drop) → Den Haag
#   (CS/Hoftoren/Binnenhof) → AMSTERDAM (the canal ring resolves at the climax) → bitterbal → deFEEST logo → loop.
#
# Data (all open, credit on screen in the outro):
#   heights  AHN5 lidar — CC0 (Rijkswaterstaat)
#   colours  GeoTiles colorized subtiles (TU Delft) — CC-BY 4.0, colours from Beeldmateriaal NL
# Rebuild the four .ply any time:  pipeline/nl_city_splat.py all   (see that file's docstring)
#
#   live loop:  MARTIN_LOOP=1 MARTIN_SHOW=productions/cities/cities-nl.show cargo +nightly run --release
#   record:     MARTIN_SHOW=productions/cities/cities-nl.show ./record.sh cities-nl.mp4
#
# defeest.glb / bitterbal.glb / the four *_tight.ply resolve via assets/cities/. ~89s, loops.

[settings]
kind = demo
pair = match
budget = 1200000              # crisp (override MARTIN_MORPH_COUNT=250000/500000 for previews)
ply = assets/cities/groningen_tight.ply
score = productions/cities/score.txt   # moody A-minor synthwave night-drive (this production's own track)
flash = 0.25
bg_dim = 0.4
post = chroma                 # the kill-shot screen-tear: RGB-split on the kick (beat-gated, deterministic)
morph_stagger = 0.6           # per-splat staggered morph timing — the cities DISSOLVE + reform instead of
                              # sliding as a block (kills the straight-line streaks). 0 = off, ~0.6 = cloudy.
pw_step = 0.35
pw_splat = 0.004

# LAYER 1 — logo → NL city tour (per-city sky/weather/pulse) → Amsterdam balls into a bitterbal → the logo.
# (utrecht_tight.ply stays available for swaps — regenerate any city via pipeline/nl_city_splat.py.)
[reel]
glb:defeest.glb           @@intro      @5,5    beat:1.2   backdrop:stars                          # deFEEST mesh ⇄ blobs → city (beat-pulse = alive while held)
splat:groningen_tight.ply @@drop       @6,7,0  ~morph  beat:0.8                 backdrop:stars      # GRONINGEN — home turf: the Martinitoren assembles out of the logo, night, calm
splat:rotterdam_tight.ply              @6,7,0  ~shockwave  ease:snap  beat:1.4  flash:0.5  ^turbulence:0.2  raster:position  backdrop:stars  # ROTTERDAM — the skyline (THE kill-shot drop): blasts in as a radial shockwave, snaps on the kick
splat:denhaag_tight.ply   @@breakdown  @6,7,0  ~morph  beat:1.0  ^wind:0.25     backdrop:northern   # DEN HAAG — wind + an aurora glow over the Hofvijver
splat:amsterdam_tight.ply @@climax     @16,7,0 ~morph  beat:1.6  flash:0.5  ^ripple:0.15  backdrop:rings   # AMSTERDAM — the canal ring resolves, climax, holds
mesh:bitterbal.glb        @@outro      @2,6,0  ~morph  tint:fry  beat:1.0       backdrop:stars      # the SKYLINE balls up into a giant DEEP-FRIED BITTERBAL
mesh:defeest.glb          rot:180,0,0  @3,5    ~morph  beat:0                   backdrop:stars      # bitterbal → the deFEEST logo (splats, rot cancels the base flip-X) → wrap to the intro (CAUSAL LOOP)

# LAYER 2 — wordmark handwrites over the cities; a small bitterbal drifts through earlier (the motif);
# the open-data credit shows during Amsterdam. All gone before the bitterbal/logo finale so it reads clean.
[stage]
text:deFEEST          @0,0.26,0    *0.42  ~pen-write  tint:brand                in breakdown  out outro   # wordmark handwrites in, blue→gold
mesh:bitterbal.glb    @0.22,0.08,0.35 *0.08  spin 17,43,11  bob 0.03  ^turbulence:0.3  drift 0.013,0,-0.003  ~morph  tint:fry  count:2500  in drop  out breakdown  # the snack motif — FORWARD (z0.35) to stay in front of the backdrop city without leaving the diving-camera frame
text:AHN · TU Delft   @0,-0.4,0    *0.5   ~fade  tint:brand                    in climax  out outro       # open-data credit (AHN CC0 heights · GeoTiles/TU Delft CC-BY colours)

# camera: high raked establishing on the logo → dive → city tour (frontal through the write) → the DOME
# on the climax → PULL BACK to frame the skyline balling into the bitterbal → and the logo forming at
# the intro pose, so the loop seam (logo → logo, through black) is invisible.
[camera]
t=@@intro      pos=0,0.6,0      dist=4.2   yaw=0.95  pitch=0.70   # FAR + high: logo tiny in the void, dramatic
t=@@bar:1      pos=0,0.30,0     dist=1.7   yaw=1.25  pitch=0.45   # FAST push — the logo rushes the camera
t=@@bar:2      pos=0.12,0.08,0  dist=1.05  yaw=1.62  pitch=0.16   cut   # hard CUT to a low raking angle on the beat
t=@@bar:3      pos=-0.10,0.16,0 dist=1.35  yaw=1.40  pitch=0.32   # swing back, riding the logo with energy
t=@@drop       pos=0,0.12,0     dist=1.2   yaw=1.44  pitch=0.26   # dive into GRONINGEN (unchanged loop seam)
t=27.0         pos=-0.1,0.05,0  dist=0.9   yaw=1.46  pitch=0.16   # descend low into the formed city
t=32.0         pos=0.10,0.04,0  dist=0.78  yaw=1.48  pitch=0.14   # low pass THROUGH the Rotterdam towers
t=@@breakdown  pos=0,0.12,0     dist=0.95  yaw=1.50  pitch=0.15   # HOLD head-on — the wordmark handwrites
t=49.0         pos=0,0.12,0     dist=0.94  yaw=1.50  pitch=0.15   # hold so the write breathes
t=@@climax     pos=0,0.14,0     dist=0.95  yaw=1.43  pitch=0.22   # AMSTERDAM — the curved-earth DOME hero shot
t=66.0         pos=0,0.18,0     dist=1.2   yaw=1.45  pitch=0.28   # rise out of the dome
t=@@outro      pos=0,0.22,0     dist=1.55  yaw=1.45  pitch=0.36   # pull back to frame the skyline balling up
t=82.0         pos=0,0.45,0     dist=3.0   yaw=1.15  pitch=0.60   # the bitterbal becomes the logo, pulling away…
t=88.5         pos=0,0.6,0      dist=4.2   yaw=0.95  pitch=0.70   # …back to the FAR intro pose → seamless far→far loop

# [sync] — the music-timed LOOK track: keyframe the global knobs over the score so the look breathes
# with the music. Bloom swells into the drop + climax; the backdrop dims for the climax drama and
# lifts in the breakdown; beat-reactivity ramps to the climax.
[sync]
t=@@intro      flash=0.35  bg_dim=0.45  beat=1.0    # PUNCHY open — the logo rushes in with energy
t=@@bar:2      flash=0.75  bg_dim=0.35  beat=1.4    # FLASH hit on the hard cut
t=@@drop       flash=0.55  bg_dim=0.35  beat=1.3    # bloom + energy lift into the drop
t=@@breakdown  flash=0.1   bg_dim=0.55  beat=0.6    # pull back, backdrop lifts, hushed
t=@@climax     flash=0.7   bg_dim=0.2   beat=1.7    # peak: bright bloom, dim backdrop, full beat
t=@@outro      flash=0.25  bg_dim=0.45  beat=0.8    # ease down toward the loop
