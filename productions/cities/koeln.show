# martin — KÖLN: the EVOKE greeting. Dom → across the Rhine over the Deutzer Brücke → Deutz →
# KALK — ending in an orbit over the ABENTEUERHALLEN, the hall the audience is sitting in.
# German open data (NRW bDOM50: RGB from the 2024/25 aerial imagery, license dl-zero = CC0 class,
# no attribution required — courtesy: "Geodaten © Land NRW, opengeodata.nrw.de"). Unlike the AHN
# lidar, the bDOM is a colored SURFACE model, so the Rhine shows as colored water, not a black void.
#   pipeline/nl_city_splat.py koeln --segments 3 --count 6000000 --seg-overlap 0.25 \
#       --rainbow-seg 1 --tile-cap 6000000    (26M corridor points → 3 segments at ~8M, 43 cm splats)
[settings]
kind = demo
ply = assets/cities/koeln_seg0_tight.ply
budget = 8300000              # MAX density (43 cm splats). Window ≈ 4 clouds → 33M resident live/stills; RECORDS must resample: MARTIN_MORPH_COUNT=3000000 + MARTIN_SPLAT_WARN=16000000
normalize = 0
pair = match
morph_stagger = 0.5
score = productions/cities/score.txt
flash = 0.25
bg_dim = 0.5
pw_step = 0.35
pw_splat = 0.004

# The RAINBOW arc: Dom segment in true color -> the middle segment (the Rhine crossing + Deutz)
# in raster:position rainbow -> back to true color arriving at Kalk. The pair=match seam morphs ARE
# the color transitions: the city recolors around you mid-flight. Slots: 85/3 = 28.3 s.
[reel]
splat:koeln_seg0_tight.ply  @20.3,8,0  ~morph  beat:0.7  backdrop:stars
splat:koeln_seg1_rainbow_tight.ply  @20.3,8,0  ~morph  beat:1.1  flash:0.4  backdrop:stars
splat:koeln_seg2_tight.ply  @20.3,8,0  ~morph  beat:0.7  backdrop:stars

# LAYER 2 — the branding: the deFEEST wordmark handwrites in over the RAINBOW city (mid-flight,
# hanging in the sky ahead of the camera), and EVOKE 2026 fades in above the Abenteuerhallen for
# the finale orbit + pull-up. Positions sit where the camera LOOKS at those times (it traverses
# the world here, unlike the orbiting cities shows).
[stage]
text:deFEEST     @0.28,0.02,0.17  *0.14  rot 0,-90,0  ~pen-write  tint:brand  in breakdown  out climax
text:EVOKE 2026  @0.90,0.012,0.20  *0.12  rot 90,0,180  ~fade  tint:brand  in climax

[camera]
t=0.0   pos=-0.9244,0.0131,-0.2027  dist=0.38    yaw=-2.30  pitch=0.78
t=6.0   pos=-0.9244,0.0131,-0.2027  dist=0.10    yaw=-2.10  pitch=0.48
t=8.5   pos=-0.7933,0.0131,-0.0549  dist=0.0731  yaw=-2.40  pitch=0.42
t=17.7  pos=-0.6366,0.0131,0.0899   dist=0.0731  yaw=-3.02  pitch=0.42
t=31.2  pos=-0.3231,0.0131,0.1280   dist=0.0731  yaw=-3.06  pitch=0.42
t=56.0  pos=0.2516,0.0131,0.1750    dist=0.0731  yaw=-3.10  pitch=0.42
t=78.0  pos=0.9244,0.0131,0.2027    dist=0.085   yaw=-3.10  pitch=0.42
t=83.0  pos=0.9244,0.0131,0.2027    dist=0.075   yaw=-1.60  pitch=0.46
t=88.5  pos=0.9244,0.0131,0.2027    dist=0.45    yaw=-0.60  pitch=0.85

[sync]
t=@@intro      flash=0.3   bg_dim=0.55  beat=0.8
t=@@drop       flash=0.45  bg_dim=0.4   beat=1.1
t=@@climax     flash=0.6   bg_dim=0.3   beat=1.5
t=@@outro      flash=0.2   bg_dim=0.55  beat=0.7
