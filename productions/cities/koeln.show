# martin — KÖLN: the EVOKE greeting. Dom → across the Rhine over the Deutzer Brücke → Deutz →
# KALK — ending in an orbit over the ABENTEUERHALLEN, the hall the audience is sitting in.
# German open data (NRW bDOM50: RGB from the 2024/25 aerial imagery, license dl-zero = CC0 class,
# no attribution required — courtesy: "Geodaten © Land NRW, opengeodata.nrw.de"). Unlike the AHN
# lidar, the bDOM is a colored SURFACE model, so the Rhine shows as colored water, not a black void.
#   pipeline/city_splat.py koeln --segments 3 --count 6000000 --seg-overlap 0.25 \
#       --rainbow-seg 1 --tile-cap 6000000    (26M corridor points → 3 segments at ~8M, 43 cm splats)
[settings]
kind = demo
ply = assets/cities/koeln_seg0_tight.ply
budget = 8300000              # MAX density (43 cm splats). Window ≈ 4 clouds → 33M resident live/stills; RECORDS must resample: MARTIN_MORPH_COUNT=3000000 + MARTIN_SPLAT_WARN=16000000
normalize = 0
pair = match
morph_stagger = 0.5
score = productions/cities/score.txt
flash = 0.25
bg_dim = 0.5
pw_step = 0.35
pw_splat = 0.004
cam_spline = 1                # Catmull-Rom flowing glide, not per-leg smoothstep — the 3 long
                              # cruising legs (t=17.7→56.0) are near-constant speed/heading and
                              # were reading as 3 stop-start pushes instead of one continuous flyover
post = chroma                 # the family's kill-shot signature (cities-defeest/cities-nl/skyline
                              # all carry it) — beat-gated RGB screen-tear, koeln had none
cam_pump = 0.03                # subtle kick-driven camera lunge — the whole flight gets a live pulse
                              # on top of the authored track (small value: this is a single 89s play,
                              # not a looping background where the shake would wear out its welcome)

# The RAINBOW arc: Dom segment in true color -> the middle segment (the Rhine crossing + Deutz)
# in raster:position rainbow -> back to true color arriving at Kalk. The pair=match seam morphs ARE
# the color transitions: the city recolors around you mid-flight — timed to the SCORE's anchors
# (bpm 124: build 7.7s, drop 19.35s, breakdown 42.6s, climax 50.3s), not an even 3-way split. The
# old even split (85/3≈28.3s slots) put both morphs off-beat and left the climax — the track's one
# real peak — sitting mid-hold with no visual event at all.
#
# NOTE on the timing math: a part's declared `@hold,morph,0` describes ITS OWN window — `morph` is
# how long IT takes to cross-fade IN from the PREVIOUS part (not how long the current part takes to
# fade OUT), so the visual reveal for part N actually happens in the FIRST `morph` seconds of part
# N's own window, i.e. starting the moment the PREVIOUS part's hold+morph elapses. Confirmed by
# stills: seg1 (@26.95,4,0) becomes active at t=19.4 (seg0's 15.35+4) — right on the drop — and its
# rainbow reveal visibly unfolds over the next ~4s (a colour-scatter mid-crossfade at t≈21-22,
# settled by t≈23), same shape at the seg1→seg2 handoff (active at 50.3, right on the climax,
# settled true-color by ~t=55). So the reveal STARTS on the beat and blooms outward from it, rather
# than snapping instantly — reads as "the drop/climax visibly detonates the city's colour," which
# plays better than an instant cut would at this camera distance anyway.
[reel]
splat:koeln_seg0_tight.ply  @15.35,4,0  ~morph  beat:0.7  backdrop:stars
splat:koeln_seg1_rainbow_tight.ply  @26.95,4,0  ~morph  beat:1.1  flash:0.4  backdrop:rings
splat:koeln_seg2_tight.ply  @34.7,4,0  ~morph  beat:0.7  backdrop:stars

# LAYER 2 — the branding: the deFEEST wordmark handwrites in over the RAINBOW city (mid-flight,
# hanging in the sky ahead of the camera), and EVOKE 2026 pen-writes in above the Abenteuerhallen
# during the finale orbit. Both needed a second round of tuning past the visible-in-3-stills first
# pass — a full-motion watch (and a user catching a MIRRORED "EVOKE 2026") surfaced two things
# stills at sparse timestamps missed:
#
#   1. GROUND OCCLUSION, not frame-top clipping. The engine sorts translucent gaussians PER CLOUD
#      (its own centre-depth), not per-pixel across clouds — a text prop sitting near flight-line
#      height (y≈0.01-0.02, right at typical rooftop height for this corridor) gets silently
#      painted over by the terrain cloud wherever their silhouettes overlap on screen: the letters
#      look like they're "sinking into the ground" even though nothing actually occludes them
#      geometrically. The safe band between "too low → eaten by terrain" and "too high → the *0.14
#      word projects past the frame's top edge at this close orbit dist (~0.07)" is NARROW — deFEEST
#      needed *0.045 (down from *0.14) at y=0.02 to fit cleanly across the WHOLE window, INCLUDING
#      the brief transient right as the pen-write starts tracing (t≈44, only ~1.4s into the 3.6s
#      reveal — the partially-drawn word sits differently than the finished one, so a size that
#      clears the FINISHED word at t=46+ can still clip during that transient); y=0.20 was already
#      fully off-frame. Verified letter-clean, no ground-eating or top-clip, at t=43/44/45/46/47/
#      48/49/50 — dense, not 3 sparse points — and at the SAME splat density (400k) as the delivered
#      preview, not just the denser 1.5M calibration renders (a first pass looked clean at 1.5M and
#      still clipped at 400k).
#
#   2. Text rotation is Y-AXIS ONLY (`rot 0,Y,0`) — X must stay 0. An X component tips the glyph
#      plane FLAT (edge-on to a level camera) instead of upright; that's what made the original
#      `90,0,180` attempt (and later `90,0,-90`) render as thin unreadable slivers. And the correct
#      Y depends on the CAMERA'S YAW at viewing time: Y=0 faces yaw≈1.4 (the engine's FRONT_YAW);
#      Y=±90 is edge-on to that same direction; Y=180 shows the MIRROR (letters backward — exactly
#      the "spiegelbeeld" bug). Because deFEEST is a single flyby at a near-constant camera yaw
#      (≈-3.08 through its whole window), one Y (-90) reads cleanly throughout. EVOKE sits inside a
#      146°-yaw ORBIT (t=78 yaw=-3.10 → t=88.5 yaw=-0.60) — no single Y stays front-facing across
#      that whole sweep. Also: its z=0.42 lateral offset (needed so the word isn't buried at
#      y=0.012, same trap as #1) puts it OUTSIDE the camera's horizontal FOV during the straight
#      approach — it doesn't actually enter frame until the orbit's yaw sweeps far enough round, ~
#      t=81, no matter what its own fade/write-in timing says. Fix: `in` retimed to 79 (so the
#      pen-write reveal lands inside the t=81+ visible window, not before it), and Y=-150 — tuned
#      for yaw≈-1.6 to -2.5 (the meat of that visible arc, found by sweeping Y against the real
#      camera yaw in an isolated test rig) rather than borrowing deFEEST's -90 (correct for a
#      completely different yaw). Verified clean + unmirrored at t=81/83/85/87.
[stage]
text:deFEEST     @0.28,0.02,0.17  *0.045  rot 0,-90,0  ~pen-write  tint:brand  in breakdown  out climax
text:EVOKE 2026  @0.90,0.012,0.42  *0.14  rot 0,-150,0  ~pen-write  tint:brand  in 79

[camera]
t=0.0   pos=-0.9244,0.0131,-0.2027  dist=0.38    yaw=-2.30  pitch=0.78
t=6.0   pos=-0.9244,0.0131,-0.2027  dist=0.10    yaw=-2.10  pitch=0.48
t=8.5   pos=-0.7933,0.0131,-0.0549  dist=0.0731  yaw=-2.40  pitch=0.42
t=17.7  pos=-0.6366,0.0131,0.0899   dist=0.0731  yaw=-3.02  pitch=0.42
t=31.2  pos=-0.3231,0.0131,0.1280   dist=0.0731  yaw=-3.06  pitch=0.42
t=40.0  pos=-0.1190,0.0131,0.1450   dist=0.14    yaw=-3.07  pitch=0.28  # becalm — the breakdown hush
                                                                        # gets a wider, level, contemplative
                                                                        # shot instead of coasting unchanged
t=@@climax pos=0.1190,0.0131,0.1640 dist=0.065   yaw=-3.09  pitch=0.48  # lunge IN right on the peak —
                                                                        # the colour-detonation gets a
                                                                        # camera reaction, not a coast-through
t=56.0  pos=0.2516,0.0131,0.1750    dist=0.0731  yaw=-3.10  pitch=0.42  # springs back out of the lunge
t=@@outro pos=0.9244,0.0131,0.2027  dist=0.085   yaw=-3.10  pitch=0.42  # was a hardcoded t=78.0, 4.5s
                                                                        # adrift from the section it's
                                                                        # meant to open — now anchor-locked
t=83.0  pos=0.9244,0.0131,0.2027    dist=0.075   yaw=-1.60  pitch=0.46
t=88.5  pos=0.9244,0.0131,0.2027    dist=0.45    yaw=-0.60  pitch=0.85

[sync]
t=@@intro      flash=0.3   bg_dim=0.55  beat=0.8  tint_music=-0.3  fov=1.0   # cool bookend — true-color Dom
t=@@drop       flash=0.45  bg_dim=0.4   beat=1.1  fov=0.85          # lens punches in a hair on the hit
t=21           flash=0.85  bg_dim=0.35  beat=1.3                    # CELEBRATE the confetti-scatter mid-
                                                                     # crossfade (~1.6s into the reveal —
                                                                     # a chaotic colour-swirl otherwise
                                                                     # flown straight through unremarked)
t=23           flash=0.5   bg_dim=0.4   beat=1.1   fov=1.0          # settle as the rainbow resolves
t=@@drop+11bar flash=0.5   bg_dim=0.35  beat=1.0    # the drop's fill-bar escalation gets a bloom lift
t=@@breakdown  flash=0.2   bg_dim=0.55  beat=0.7  tint_music=0.6   # the hush (padsw=4 basssw=2) was
                                                     # invisible before — 31s straight ramp drop→climax
                                                     # with no event; warm tint marks the rainbow hold
t=@@climax     flash=0.7   bg_dim=0.25  beat=1.7  fov=0.88          # matched to the cities-nl/cities-
                                                                     # defeest ceiling; fov stays modest
                                                                     # here — the camera ALREADY lunges
                                                                     # (dist 0.065) at this exact anchor,
                                                                     # stacking a big fov punch on top of
                                                                     # that lost the horizon entirely
t=52           beat=2.2                                             # a BEAT spike (not flash — climax is
                                                                     # already at its brightness ceiling)
                                                                     # right on the climax's own confetti-
                                                                     # scatter, ~1.6s into ITS reveal
t=54           beat=1.5   fov=0.85                                  # settle as Kalk resolves, lens eases
t=@@outro      flash=0.2   bg_dim=0.55  beat=0.7  tint_music=-0.2  fov=1.0   # cool bookend — true-color Kalk

# [caption] — screen-pinned data credit only (the landmark call-outs read lame, dropped). "Geodaten ©
# Land NRW" matches the header's own courtesy-attribution wording verbatim (no attribution is legally
# required for dl-zero, but crediting the source is the polite/honest move for open data).
[caption]
screentext:Geodaten © Land NRW — open data  in 84  out 89  at 0.5,0.94  size 16  center  fade 1.0
