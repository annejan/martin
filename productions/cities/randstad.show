# martin — THE RANDSTAD FLIGHT: Rotterdam Markthal → Delft → Rijswijk → Den Haag CS/Binnenhof →
# the dunes → Scheveningen — ~24 km of real Dutch open-data city in ONE continuous streamed flight.
# 8 overlapping arc-length segments in one shared frame (normalize = 0), each seam a pair=match
# in-place dissolve: the city streams in ahead and out behind, unlimited length under the GPU cap.
#   pipeline/city_splat.py randstad --segments 8 --count 700000 --emit-camera --duration 85
# 131.3M corridor points → 8 × ~1M splats. Data: AHN CC0 · GeoTiles CC-BY (TU Delft).
# NOTE camera dist: a 24 km route normalizes ~3× smaller than a city block — dist 0.10 here is the
# "close, more land than sky" height that dist 0.28 gives on a short route.

[settings]
kind = demo
ply = assets/cities/randstad_seg0_tight.ply
budget = 1000000
normalize = 0
pair = match
score = productions/cities/score.txt
morph_stagger = 0.4
flash = 0.25
bg_dim = 0.45

[reel]
splat:randstad_seg0_tight.ply  @4.6,6,0  ~morph  backdrop:stars
splat:randstad_seg1_tight.ply  @4.6,6,0  ~morph  backdrop:stars
splat:randstad_seg2_tight.ply  @4.6,6,0  ~morph  backdrop:stars
splat:randstad_seg3_tight.ply  @4.6,6,0  ~morph  backdrop:stars
splat:randstad_seg4_tight.ply  @4.6,6,0  ~morph  backdrop:stars
splat:randstad_seg5_tight.ply  @4.6,6,0  ~morph  backdrop:stars
splat:randstad_seg6_tight.ply  @4.6,6,0  ~morph  backdrop:stars
splat:randstad_seg7_tight.ply  @4.6,6,0  ~morph  backdrop:stars

[camera]
t=0.0  pos=0.58,0.005,0.92  dist=0.13  yaw=1.00  pitch=0.45
t=6.1  pos=0.49,0.005,0.78  dist=0.13  yaw=0.97  pitch=0.45
t=16.1  pos=0.34,0.005,0.56  dist=0.13  yaw=0.92  pitch=0.45
t=28.7  pos=0.14,0.005,0.30  dist=0.13  yaw=0.77  pitch=0.45
t=43.2  pos=-0.14,0.005,0.03  dist=0.13  yaw=1.33  pitch=0.45
t=50.9  pos=-0.19,0.005,-0.17  dist=0.13  yaw=1.42  pitch=0.45
t=57.6  pos=-0.21,0.005,-0.34  dist=0.13  yaw=1.23  pitch=0.45
t=64.6  pos=-0.27,0.005,-0.52  dist=0.13  yaw=1.24  pitch=0.45
t=69.7  pos=-0.32,0.005,-0.65  dist=0.13  yaw=0.06  pitch=0.45
t=72.6  pos=-0.39,0.005,-0.65  dist=0.13  yaw=0.87  pitch=0.45
t=76.9  pos=-0.47,0.005,-0.74  dist=0.13  yaw=1.15  pitch=0.45
t=82.2  pos=-0.53,0.005,-0.87  dist=0.15  yaw=0.79  pitch=0.45
t=88.5  pos=-0.60,0.10,-0.95  dist=0.8  yaw=0.70  pitch=0.55

[sync]
t=@@intro      flash=0.3   bg_dim=0.5   beat=0.9
t=@@drop       flash=0.5   bg_dim=0.35  beat=1.2
t=@@climax     flash=0.6   bg_dim=0.25  beat=1.5
t=@@outro      flash=0.2   bg_dim=0.5   beat=0.7
