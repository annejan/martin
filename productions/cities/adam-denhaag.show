splat:adam_denhaag_seg6_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
splat:adam_denhaag_seg7_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
splat:adam_denhaag_seg8_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
splat:adam_denhaag_seg9_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
splat:adam_denhaag_seg10_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
splat:adam_denhaag_seg11_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
splat:adam_denhaag_seg12_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars

