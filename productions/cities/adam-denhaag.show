# martin — VAN DE LANGE VONDER NAAR DE HOFTOREN: het Schelvischhoofd (Amsterdam-Noord) → across
# the IJ past CS → Dam → the canal ring → SCHIPHOL (over the runways) → the Kagerplassen → Leiden →
# Voorschoten → the HOFTOREN (Rijnstraat 8, Den Haag). ~59 km of the Netherlands in ONE continuous
# streamed flight: 13 arc-length segments in one shared frame, 189.7M lidar points, 169 subtiles.
# Start/end geocoded via the PDOK Locatieserver. Water (IJ, Kagerplassen) returns no lidar — the
# land simply ends there and the flight crosses black voids. Data: AHN CC0 · GeoTiles CC-BY.
#   pipeline/nl_city_splat.py adam-denhaag --segments 13 --count 700000 --emit-camera --duration 85
# Slot sync: 85 s / 13 segments = 6.54 s → @2.6,3.94 per part (see randstad.show for why exact).

[settings]
kind = demo
ply = austin_run/exports/adam_denhaag_seg0_tight.ply
budget = 1000000
normalize = 0
pair = match
score = productions/cities/score.txt
morph_stagger = 0.4
flash = 0.25
bg_dim = 0.45

[reel]
splat:adam_denhaag_seg0_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
splat:adam_denhaag_seg1_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
splat:adam_denhaag_seg2_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
