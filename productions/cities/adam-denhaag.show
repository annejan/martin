# martin — VAN DE LANGE VONDER NAAR DE HOFTOREN (rev. 2 — 800 m corridor + staged open/close):
# het Schelvischhoofd (Amsterdam-Noord) → across the IJ past CS → Dam → the canal ring → SCHIPHOL →
# the Kagerplassen → Leiden → Voorschoten → the HOFTOREN. ~59 km, 13 streamed segments, 181
# subtiles. Direction: a high ESTABLISHING over the Lange Vonder while segment 0 assembles below,
# dive to flight level, the long flight, then BRAKE at the Hoftoren, a half-orbit around the tower,
# and a pull-up into the stars on the outro. Data: AHN CC0 · GeoTiles CC-BY (TU Delft).
#   pipeline/nl_city_splat.py adam-denhaag --segments 13 --count 800000 --emit-camera --duration 85

[settings]
kind = demo
ply = austin_run/exports/adam_denhaag_seg0_tight.ply
budget = 480000               # streaming window holds FOUR clouds — 4×480k = 1.92M resident, under the 2M record cap
normalize = 0
pair = match
score = productions/cities/score.txt
morph_stagger = 0.4
flash = 0.25
bg_dim = 0.45

[reel]
splat:adam_denhaag_seg0_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
splat:adam_denhaag_seg1_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
splat:adam_denhaag_seg2_tight.ply  @2.6,3.94,0  ~morph  backdrop:stars
