# martin — NEBULA: the additive-glow demoscene showcase. Procedural space shapes (galaxy/saturn/
# helix/supershape/torus) ball-pulse morph on PURE BLACK with MARTIN_ADDITIVE (One+One emissive
# blend) — overlapping translucent splats ACCUMULATE light and glow instead of alpha-saturating to a
# muddy blob. On martin's OWN composed synthwave loop (no copyright). Camera never settles — a
# relentless slow orbit + push-ins on the beats (the cities-energy lesson: energy the whole way, not
# just the opening seconds).
#
#   cargo run --release -- --production nebula
#
# Section starts (s, 124 BPM, bar=1.935s — same score as synthwave): intro 0 · build 7.7 · drop 23.2
#   · break 38.7 · climax 46.5 · outro 61.9 · end 69.7.

[settings]
kind = demo
budget = 120000
ply = assets/galaxy.ply
score = productions/synthwave/score.txt
additive = 1                          # glow-on-black is the WHOLE POINT of this show
bg_dim = 0.0
flash = 0.5                           # a soft bloom kiss on the morph cuts
beat = 0.30                           # gentle glow-pulse on the kick
particles = sparks
particle_at = @@drop
particle_out = @@outro

# --- the reel. Ball-pulse ~morph backbone throughout; backdrop:off everywhere (a coloured backdrop
#     would blow out under additive — this show IS the backdrop, pure black + glowing shapes). The
#     outro signature is additive:0 so the deFEEST text reads crisp white instead of blowing to a
#     featureless glow-blob — a direct use of the new per-part additive override. ---
[reel]
splat:galaxy.ply              @@intro    @5,2.4,1.4 ~morph     ^twist        backdrop:off   # nebula spiral swirls in
splat:saturn.ply               @@build    @5,1.6,1.5 ~morph     ^spiral       backdrop:off   # glowing ringed star forms
splat:helix.ply                @@drop     @5.5,1.3,1.7 ~explode ^turbulence   backdrop:off   # neon DNA laser-tube blasts together
splat:supershape.ply           @@bar:16   @5,1.4,1.6 ~morph     ^turbulence   backdrop:off   # rainbow glow-bloom
text:N E B U L A               @@bar:18   @4,1.2     ~typewriter ^wave        backdrop:off   # title, per-char, glowing
text:additive glow · martin   @@break    @6,2.4     ~outline    ^wave         backdrop:off   # calm breakdown line
shader:bolt                    @@climax   @1.4,0.3                                          # 1-bar fullscreen blinder
splat:torus.ply rot:62,0,18    @@bar:25   @6,1.3,1.5 ~vortex    ^spiral       backdrop:off   # glowing donut spins up out of a vortex
splat:knot.ply                 @@bar:28   @5.5,1.4,1.6 ~morph   ^turbulence   backdrop:off   # tumbling glow-knot
splat:galaxy.ply                @@bar:30   @5.5,1.6,1.4 ~morph  ^twist        backdrop:off   # collapses back into the nebula
text:deFEEST                   @@outro    @5,3.5     ~pen-write ^wave additive:0 exit:evaporate backdrop:off # crisp signature (NOT additive), evaporates

# --- the camera: NEVER settles — continuous slow orbit (yaw always sweeping) + push-ins on the
#     drop/climax for punch. Glow reads best at dist 2.2-2.8, pitch 0.15-0.4 (from the additive A/B). ---
[camera]
t=0.0     pos=0,0,0   dist=2.8   yaw=1.20   pitch=0.30   # open on the nebula, head-on glow
t=7.7     pos=0,0,0   dist=2.5   yaw=1.55   pitch=0.25   # orbit as Saturn forms
t=16.0    pos=0,0,0   dist=2.7   yaw=2.00   pitch=0.35   # keep drifting around the ringed star
t=23.2    pos=0,0,0   dist=1.9   yaw=1.30   pitch=0.20   # DROP — push in hard on the helix blast
t=31.0    pos=0.15,0,0 dist=2.2  yaw=2.20   pitch=0.28   # orbit across the glow-bloom
t=38.7    pos=0,0,0   dist=3.0   yaw=1.40   pitch=0.15   # fall back + centre for the calm break
t=46.5    pos=0,0,0   dist=2.0   yaw=1.45   pitch=0.25   # CLIMAX blinder — brief slam
t=48.4    pos=0,0,0   dist=2.7   yaw=1.10   pitch=0.20   # torus: pulled back so it reads full…
t=52.0    pos=0,0,0   dist=2.7   yaw=2.30   pitch=0.38   # …camera arcs over it → the donut turns
t=54.2    pos=0,0,0   dist=2.5   yaw=1.60   pitch=0.22   # the knot tumbles into view
t=58.1    pos=0,0,0   dist=2.6   yaw=2.00   pitch=0.30   # galaxy reforms as the climax closes
t=61.9    pos=0,0,0   dist=3.0   yaw=1.42   pitch=0.10   # settle for the pen-write signature
t=68.0    pos=0,0,0   dist=3.4   yaw=1.45   pitch=0.08   # gentle pull-back as it evaporates to black
